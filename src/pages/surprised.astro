---
import Base from '../layouts/Base.astro';
import { ID, abs, breadcrumb, graph, itemList, person, website } from '../lib/seo';

/**
 * The Surprised arcade: a searchable, paginated gallery of self-contained games
 * that each teach one idea, from primary-school logic to how a neural network
 * actually learns. Every game lives in src/scripts/surprised.js and mounts into
 * its card on demand; this file is the shell, the copy, and the gallery UI.
 *
 * It is the one page that ships client JavaScript, because a game you cannot
 * play is not a game. Published in English only: the games are interactive, not
 * prose, so there is nothing to translate but the chrome.
 */

type Cat = 'ml' | 'arch' | 'logic' | 'maths' | 'physics' | 'mind';
type Game = { id: string; title: string; cat: Cat; tag: string; learn: string; how: string };

const CATEGORIES: { key: Cat; label: string; blurb: string }[] = [
  { key: 'ml', label: 'Machine Learning', blurb: 'The ideas behind how machines learn, made small enough to play with: a line that fits itself, a neuron, a network that solves what one line cannot.' },
  { key: 'arch', label: 'AI Architectures', blurb: 'What is really inside a modern AI model: softmax, attention, a tiny language model, state-space memory, embeddings, and a builder to feel how parameters explode.' },
  { key: 'logic', label: 'Logic & Puzzles', blurb: 'Puzzles with a right answer hiding in plain sight, from river crossings to Sudoku, and one game a computer has solved completely.' },
  { key: 'maths', label: 'Maths', blurb: 'Numbers, primes, fractions, slopes, areas, vectors, and matrices, each turned into something with a score, including the calculus that training runs on.' },
  { key: 'physics', label: 'Physics', blurb: 'Little sandboxes running the real equations: gravity, torque, oscillation, springs, and elastic collisions.' },
  { key: 'mind', label: 'Mind & Senses', blurb: 'Memory, reflex, and attention, measured on you.' },
];

const GAMES: Game[] = [
  // --- Machine Learning ---
  { id: 'gradient-descent', cat: 'ml', title: 'Rolling Downhill', tag: 'Gradient descent', learn: 'Training a model is just rolling a ball downhill on its error. The slope says which way to go; the learning rate says how big a step to take. Too big and it flies out of the valley.', how: 'Drop the ball and press Auto-roll. If it diverges, lower the learning rate.' },
  { id: 'classify', cat: 'ml', title: 'Draw the Boundary', tag: 'Classification', learn: 'A classifier draws a line between two kinds of thing. Everything on one side is an apple, the other an orange. That line is the whole model.', how: 'Move the line with the sliders, or press Let it learn to watch it place itself.' },
  { id: 'perceptron', cat: 'ml', title: 'One Neuron', tag: 'The neuron', learn: 'A neuron adds its inputs times their weights and fires if the total clears zero. That is the atom of every neural network, and it can learn simple gates on its own.', how: 'Tune the weights so the neuron matches the target gate, or press Train.' },
  { id: 'neural-net', cat: 'ml', title: 'Learn XOR', tag: 'Backpropagation', learn: 'One neuron can only draw a straight line, so it cannot solve XOR. Add a hidden layer and it can bend space until a boundary fits. Backpropagation is how it finds the bends.', how: 'Press Train and watch the colours carve the board until each corner is right.' },
  { id: 'activation', cat: 'ml', title: 'Activation Curves', tag: 'Activations', learn: 'Between layers each neuron passes its total through a curve that decides how much to fire. Without that bend, stacking layers just gives you one big straight line.', how: 'Pick a function and slide the input to see its shape.' },
  { id: 'kmeans', cat: 'ml', title: 'Find the Groups', tag: 'Clustering', learn: 'With no labels at all a machine can still find groups: guess some centres, colour each point by its nearest, slide the centres to the middle, and repeat until nothing moves.', how: 'Choose how many groups, then press Step until it settles.' },
  { id: 'knn', cat: 'ml', title: 'Ask the Neighbours', tag: 'Nearest neighbours', learn: 'The simplest classifier there is: to label a new point, just ask its closest neighbours to vote. More neighbours means a smoother, calmer boundary.', how: 'Drag the grey point around and change how many neighbours vote.' },
  { id: 'overfit', cat: 'ml', title: 'Too Clever', tag: 'Overfitting', learn: 'A model too simple misses the pattern; one too complex memorises the noise and fails on anything new. Good learning is the honest middle, and you can watch it happen.', how: 'Slide the complexity and compare the fit on the dots against unseen points.' },

  // --- AI Architectures ---
  { id: 'softmax', cat: 'arch', title: 'Scores to Choices', tag: 'Softmax', learn: 'Softmax turns a row of raw scores into probabilities that add to one. Temperature decides whether the top choice dominates or the whole field stays in play. Every model ends this way.', how: 'Move the scores and the temperature and watch the bars respond.' },
  { id: 'attention', cat: 'arch', title: 'Who Looks at Whom', tag: 'Attention', learn: 'Attention lets each word look at all the others and pull in the ones that matter. It is how a model works out that "it" means the tiger, not the deer.', how: 'Click any word to make it the question and see what it attends to.' },
  { id: 'next-token', cat: 'arch', title: 'Guess the Next Word', tag: 'Language models', learn: 'A language model does exactly one thing: guess the next word from the words so far. String those guesses together and it writes. This one learned from a few nursery rhymes.', how: "Pick from the model's suggestions to build a sentence one word at a time." },
  { id: 'state-space', cat: 'arch', title: 'The Running Memory', tag: 'State space / Mamba', learn: 'Rather than re-read every word like attention, a state-space model like Mamba keeps one running summary and updates it as each word arrives. Memory decides how far back it remembers.', how: 'Press Play and change the memory to see how long an early signal survives.' },
  { id: 'model-builder', cat: 'arch', title: 'Build a Model', tag: 'Scaling laws', learn: 'Stack layers and widen them and the parameter count explodes. More parameters can do more, but cost far more to train and run. This is why big models are big deals.', how: 'Add and widen layers, watch the counter, and see what the model might manage.' },
  { id: 'embeddings', cat: 'arch', title: 'A Map of Meaning', tag: 'Embeddings', learn: 'Words become points in space, arranged so similar meanings sit close. You can even do arithmetic with them: king minus man plus woman lands right on queen.', how: 'Tap a word to see its neighbours, then try the famous analogy.' },

  // --- Logic & Puzzles ---
  { id: 'lights-out', cat: 'logic', title: 'Lights Out', tag: 'Parity', learn: 'Every light is wired to its neighbours, so turning them all off is really a puzzle about even and odd.', how: 'Tap a light to flip it and its four neighbours. Get the whole board dark.' },
  { id: 'hanoi', cat: 'logic', title: 'Tower of Hanoi', tag: 'Recursion', learn: 'Moving a tall stack is the same problem one disc smaller, done twice. That is recursion you can watch.', how: 'Tap a peg to lift its top disc, tap another to set it down. Never rest a big disc on a smaller one.' },
  { id: 'fifteen', cat: 'logic', title: 'Fifteen Puzzle', tag: 'Planning', learn: 'Fifteen tiles and one gap. Order has to be built move by move, each of which looks like a step backward.', how: 'Click a tile next to the gap to slide it in. Arrange the numbers 1 to 15.' },
  { id: 'nim', cat: 'logic', title: 'Nim', tag: 'Game theory', learn: 'A fully solved game. The winner is fixed in advance by the exclusive-or of the piles, not by luck.', how: 'Take any number of stones from one pile. Take the very last stone to win. The computer plays perfectly.' },
  { id: 'mastermind', cat: 'logic', title: 'Mastermind', tag: 'Deduction', learn: 'Each guess is an experiment, and the feedback shrinks a space of over a thousand codes toward one.', how: 'Guess the four hidden colours. A dark key means right colour and place; a pale key means right colour, wrong place.' },
  { id: 'logic-gates', cat: 'logic', title: 'Logic Gates', tag: 'Boolean logic', learn: 'AND, OR, XOR. The whole of digital logic is a handful of these little truth machines wired together.', how: 'Flip the input switches or swap the gate until the bulb matches the goal.' },
  { id: 'river-crossing', cat: 'logic', title: 'Wolf, Goat, Cabbage', tag: 'Search', learn: 'A classic planning puzzle. Some states are traps, and the only way through is to sometimes carry things backward.', how: 'Row items across, but never leave wolf with goat, or goat with cabbage, unwatched.' },
  { id: 'missionaries', cat: 'logic', title: 'Missionaries & Cannibals', tag: 'Constraints', learn: 'Every move must keep a rule true on both banks at once. That is constraint satisfaction, the idea behind scheduling and Sudoku.', how: 'Load one or two into the boat and cross, never letting cannibals outnumber missionaries.' },
  { id: 'water-jugs', cat: 'logic', title: 'Water Jugs', tag: 'State search', learn: 'With a 5 and a 3 litre jug you can measure a 4. The reachable amounts are exactly the multiples of the two sizes’ greatest common divisor.', how: 'Fill, empty, and pour between the jugs until one holds four litres.' },
  { id: 'sokoban', cat: 'logic', title: 'Sokoban', tag: 'Planning', learn: 'You can push a box but never pull it, so one careless shove into a corner can doom the level. Real planning means thinking before you move.', how: 'Push every box onto a dot, using the arrows.' },
  { id: 'sudoku4', cat: 'logic', title: 'Mini Sudoku', tag: 'Constraints', learn: 'A tiny Sudoku. Each row, column, and box must hold every digit once, and each filled cell rules out choices for the rest.', how: 'Click a cell to cycle its number until the whole grid obeys the rules.' },

  // --- Maths ---
  { id: 'primes', cat: 'maths', title: 'Prime Sieve', tag: 'Number theory', learn: 'Cross out every multiple and the primes are simply whatever is left standing. The trick is 2000 years old.', how: 'Click a number to strike out its multiples. Keep going until only the primes survive.' },
  { id: 'times-table', cat: 'maths', title: 'Times Lightning', tag: 'Mental maths', learn: 'Instant recall of the multiplication table is a muscle. Here are thirty seconds of reps for it.', how: 'Pick the right product before the clock runs down. A wrong tap costs you two seconds.' },
  { id: 'fractions', cat: 'maths', title: 'Fraction Match', tag: 'Fractions', learn: 'A fraction is a slice of a whole, and many different fractions name the very same slice.', how: 'Read the shaded pie and pick the fraction that matches, reduced to lowest terms.' },
  { id: 'guess-line', cat: 'maths', title: 'Line of Best Fit', tag: 'Algebra', learn: 'A straight line is a slope and a height. Threading one through a cloud of points is what regression does.', how: 'Tune the slope and the intercept to fit the dots, chasing the lowest error.' },
  { id: 'estimate', cat: 'maths', title: 'Dot Estimator', tag: 'Number sense', learn: 'You can feel roughly how many things are there without counting them. That sense sharpens with practice.', how: 'The dots flash for a moment. Guess how many there were, then check.' },
  { id: 'pattern', cat: 'maths', title: 'Next in Line', tag: 'Sequences', learn: 'Add, multiply, square, or Fibonacci. Spotting the rule behind a run of numbers is the heart of the thing.', how: 'Work out the rule and choose the number that comes next.' },
  { id: 'angle', cat: 'maths', title: 'Angle Aim', tag: 'Geometry', learn: 'Degrees measure turning. Ninety is a right angle, and every target sits at one exact angle from the corner.', how: 'Point the arrow at the dot and read the angle off the protractor.' },
  { id: 'derivative', cat: 'maths', title: 'The Slope', tag: 'Calculus', learn: 'The derivative is the slope of a curve at a single point. Where the slope is zero you are at a peak or a valley, which is exactly where training stops.', how: 'Slide the point along the curve and read the slope of the pink tangent.' },
  { id: 'integral', cat: 'maths', title: 'Area Under the Curve', tag: 'Calculus', learn: 'The area under a curve is a sum of many thin rectangles. Add more and the estimate homes in on the true value. That is integration.', how: 'Add rectangles and watch the estimate approach the real area.' },
  { id: 'vectors', cat: 'maths', title: 'Dot Product', tag: 'Linear algebra', learn: 'A dot product measures how much two arrows point the same way: positive when aligned, zero at a right angle. It is the core of attention and of embeddings.', how: 'Drag the two arrows and watch the dot product and the angle.' },
  { id: 'matrix', cat: 'maths', title: 'Bend the Grid', tag: 'Linear algebra', learn: 'A 2 by 2 matrix bends the whole plane: rotate, stretch, shear, flip. Its determinant is how much area grows. Every neural layer is a matrix like this.', how: 'Change the four numbers, or try a preset, and watch the square transform.' },

  // --- Physics ---
  { id: 'projectile', cat: 'physics', title: 'The Cannon', tag: 'Projectiles', learn: 'Gravity pulls down at the same rate whatever the sideways speed, and that is exactly what bends the path into a parabola.', how: 'Set the angle and the power, then fire to land on the target.' },
  { id: 'orbit', cat: 'physics', title: 'Orbits', tag: 'Gravity', learn: 'An orbit is just falling forever and always missing. Too slow and you crash in; too fast and you escape.', how: 'Drag anywhere and release to fling a planet past the star. Find the speed that loops.' },
  { id: 'pendulum', cat: 'physics', title: 'Pendulums', tag: 'Oscillation', learn: 'A pendulum keeps time by its length alone. The weight of the bob never enters the period; longer just means slower.', how: 'Set two lengths, pull them back, and watch one beat slower than the other.' },
  { id: 'incline', cat: 'physics', title: 'The Ramp', tag: 'Acceleration', learn: 'On a slope the useful part of gravity is g times the sine of the angle. Steeper means a bigger push down the ramp.', how: 'Change the ramp angle and drop the ball. The acceleration reads out as you go.' },
  { id: 'bounce', cat: 'physics', title: 'Bounce Box', tag: 'Collisions', learn: 'When two equal balls hit, they swap the speed along the line between them. Energy sloshes around and barely leaks away.', how: 'Drag to fling a ball. Add a few more and watch them knock each other about.' },
  { id: 'balance', cat: 'physics', title: 'Balance Beam', tag: 'Torque', learn: 'What tips a lever is not weight but weight times distance from the pivot. That product is torque.', how: 'Click to the left or right of the pivot to drop a weight. Make the two sides balance.' },
  { id: 'spring', cat: 'physics', title: 'The Spring', tag: 'Oscillation', learn: 'A spring pulls back in proportion to how far you stretch it. Let go and it swings at a rhythm set by its stiffness and the mass, never by how far you pulled.', how: 'Drag the block aside and release. Change the stiffness.' },
  { id: 'collide', cat: 'physics', title: 'Cart Collisions', tag: 'Momentum', learn: 'In an elastic collision total momentum is exactly preserved. A heavy cart barely flinches when a light one hits it; two equal carts swap speeds.', how: 'Set the masses and launch. Watch the momentum readout stay fixed.' },

  // --- Mind & Senses ---
  { id: 'simon', cat: 'mind', title: 'Simon', tag: 'Working memory', learn: 'Holding a growing sequence in your head is working memory, stretched one extra step every round.', how: 'Watch the pads light up in order, then repeat the pattern back. It grows by one each time.' },
  { id: 'memory-match', cat: 'mind', title: 'Memory Match', tag: 'Recall', learn: 'Where was that pair? Memory for places improves surprisingly fast with a little play.', how: 'Flip two cards. If they match they stay. Clear the board in as few moves as you can.' },
  { id: 'reaction', cat: 'mind', title: 'Reaction Time', tag: 'Reflex', learn: 'From a flash of light to your click is about a fifth of a second. Here you can measure your own.', how: 'Wait for green, then click as fast as you can. Clicking too early sends you back.' },
  { id: 'stroop', cat: 'mind', title: 'Stroop Test', tag: 'Attention', learn: 'Reading is so automatic that naming the ink of a colour word fights the word itself. That clash is the Stroop effect.', how: 'Click the colour of the ink, not the word it spells. Thirty seconds on the clock.' },
  { id: 'binary', cat: 'mind', title: 'Binary Blocks', tag: 'Number systems', learn: 'Every whole number is a sum of powers of two, which is all a computer ever counts in. Eight switches reach 255.', how: 'Flip the switches so their place values add up to the target number.' },
];

const COUNT = GAMES.length;
const catLabel = (k: Cat) => CATEGORIES.find((c) => c.key === k)!.label;
const searchStr = (g: Game) => `${g.title} ${g.tag} ${catLabel(g.cat)} ${g.learn} ${g.how}`.toLowerCase();

const DESCRIPTION =
  'Dozens of tiny browser games that each teach one idea, from logic and physics to how a neural ' +
  'network learns and attention works. Free, no install.';

const KEYWORDS = [
  'machine learning games',
  'learn machine learning',
  'neural network game',
  'gradient descent',
  'attention mechanism',
  'transformer explained',
  'educational games',
  'physics games',
  'math games',
  'logic puzzles',
  'learn AI for kids',
  'interactive learning',
] as const;

const url = abs('/surprised/');
const surprisedSchema = graph(
  person(),
  website(),
  {
    '@type': ['CollectionPage', 'WebApplication'],
    '@id': url,
    url,
    name: 'Surprised: little games that teach',
    description: DESCRIPTION,
    inLanguage: 'en',
    isPartOf: { '@id': ID.website },
    author: { '@id': ID.person },
    applicationCategory: 'GameApplication',
    operatingSystem: 'Any modern web browser',
    browserRequirements: 'Requires JavaScript',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    keywords: KEYWORDS.join(', '),
    breadcrumb: { '@id': `${url}#breadcrumb` },
    mainEntity: { '@id': `${url}#list` },
  },
  breadcrumb([
    { name: 'Home', url: '/' },
    { name: 'Surprised', url: '/surprised/' },
  ]),
  itemList(
    url,
    GAMES.map((g) => ({ name: g.title, url: `/surprised/#game-${g.id}` })),
    {
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      itemListElement: GAMES.map((g, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'Game',
          name: g.title,
          description: g.learn,
          url: `${url}#game-${g.id}`,
          author: { '@id': ID.person },
          genre: g.tag,
          about: catLabel(g.cat),
        },
      })),
    },
  ),
);
---

<Base
  title="Surprised"
  description={DESCRIPTION}
  keywords={KEYWORDS}
  schema={surprisedSchema}
  available={['en']}
>
  <div class="surprised wrap page">
    <header class="page__head arcade-hero">
      <p class="label">A surprise arcade &nbsp;·&nbsp; {COUNT} little games</p>
      <h1 class="display page__title">Surprised</h1>
      <p class="lede page__lede">
        You found the arcade. Dozens of tiny games, each one smuggling in a single idea and made simple
        enough that an eight-year-old can feel it by playing. Start with fractions and pendulums; end up
        watching a <em>neural network</em> teach itself, or poking at how <em>attention</em> and a
        <em>language model</em> really work. Search, filter, play.
      </p>
    </header>

    <div class="arcade-controls" role="search">
      <div class="arcade-search-wrap">
        <svg class="arcade-search-icon" viewBox="0 0 20 20" aria-hidden="true" width="18" height="18">
          <circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="2"></circle>
          <line x1="13.5" y1="13.5" x2="18" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
        </svg>
        <input
          id="arcade-search"
          class="arcade-search"
          type="search"
          placeholder="Search games, ideas, subjects..."
          aria-label="Search games"
          autocomplete="off"
        />
      </div>
      <div class="arcade-chips" role="tablist" aria-label="Filter by subject">
        <button type="button" class="arcade-chip" data-cat="all" data-label="All games" aria-pressed="true">All</button>
        {CATEGORIES.map((c) => (
          <button type="button" class="arcade-chip" data-cat={c.key} data-label={c.label} aria-pressed="false">
            {c.label}
          </button>
        ))}
      </div>
    </div>

    <div class="arcade-bar">
      <h2 class="eyebrow arcade-section" id="arcade-heading">All games</h2>
      <span class="arcade-count tnum" id="arcade-count">{COUNT} games</span>
    </div>

    <div class="arcade-grid" id="arcade-grid">
      {
        GAMES.map((game) => (
          <article
            class="gamecard game"
            id={`game-${game.id}`}
            data-game={game.id}
            data-cat={game.cat}
            data-search={searchStr(game)}
          >
            <div class="gamecard__bar">
              <h3 class="gamecard__title">{game.title}</h3>
              <span class="gamecard__tag">{game.tag}</span>
            </div>
            <div class="gamecard__stage" data-stage>
              <p class="gamecard__placeholder">Loading…</p>
            </div>
            <p class="gamecard__how">{game.how}</p>
            <details class="gamecard__learn">
              <summary>What it teaches</summary>
              <p>{game.learn}</p>
            </details>
            <span class="gamecard__cat">{catLabel(game.cat)}</span>
          </article>
        ))
      }
    </div>

    <p class="arcade-empty" id="arcade-empty" hidden>
      No game matches that. Try another word, or press <strong>All</strong>.
    </p>

    <nav class="arcade-pager" id="arcade-pager" aria-label="Pages"></nav>

    <footer class="arcade-foot">
      <p>
        Every game here is a few dozen lines of plain JavaScript, no libraries, drawn with the same care
        as the rest of the site. Only twelve show at a time, so it stays light; search or filter to find
        the rest. If one breaks on your browser, that is a bug worth an email.
      </p>
    </footer>
  </div>

  <script>
    import '../scripts/surprised.js';
  </script>

  <style>
    /* --- page shell -------------------------------------------------------- */
    .arcade-hero { max-width: var(--measure); }

    .arcade-controls {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-3) var(--s-4);
      align-items: center;
      margin-top: var(--s-7);
      padding-bottom: var(--s-4);
    }
    .arcade-search-wrap {
      position: relative;
      flex: 1 1 16rem;
      min-width: 12rem;
      display: flex;
      align-items: center;
    }
    .arcade-search-icon {
      position: absolute;
      inset-inline-start: 0.7rem;
      color: var(--fg-faint);
      pointer-events: none;
    }
    .arcade-search {
      width: 100%;
      font: inherit;
      font-size: var(--t-sm);
      color: var(--fg);
      background: var(--bg-sunken);
      border: var(--rule-w) solid var(--rule);
      border-radius: 999px;
      padding: 0.6em 0.9em 0.6em 2.4em;
      transition: border-color var(--dur-fast) var(--ease);
    }
    .arcade-search:focus-visible {
      outline: none;
      border-color: var(--accent);
    }
    .arcade-chips {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-2);
    }
    .arcade-chip {
      font: inherit;
      font-size: var(--t-xs);
      font-family: var(--face-mono);
      letter-spacing: var(--tr-wide);
      text-transform: uppercase;
      cursor: pointer;
      color: var(--fg-muted);
      background: transparent;
      border: var(--rule-w) solid var(--rule-strong);
      border-radius: 999px;
      padding: 0.4em 0.8em;
      transition:
        color var(--dur-fast) var(--ease),
        border-color var(--dur-fast) var(--ease),
        background var(--dur-fast) var(--ease);
    }
    .arcade-chip:hover { color: var(--accent); border-color: var(--accent); }
    .arcade-chip[aria-pressed='true'] {
      color: #fff;
      background: var(--accent);
      border-color: var(--accent);
    }

    .arcade-bar {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--s-3);
      border-top: var(--rule-w) solid var(--rule);
      padding-top: var(--s-4);
      margin-bottom: var(--s-5);
    }
    .arcade-section { margin: 0; }
    .arcade-count { color: var(--fg-faint); font-size: var(--t-xs); font-family: var(--face-mono); }

    .arcade-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
      gap: var(--s-5);
      scroll-margin-top: var(--s-5);
    }

    .gamecard {
      display: flex;
      flex-direction: column;
      border: var(--rule-w) solid var(--rule);
      border-radius: 14px;
      background: var(--bg);
      padding: var(--s-4);
      scroll-margin-top: var(--s-6);
      transition:
        border-color var(--dur) var(--ease),
        box-shadow var(--dur) var(--ease),
        transform var(--dur) var(--ease);
    }
    .gamecard:hover {
      border-color: var(--rule-strong);
      box-shadow: 0 10px 30px -18px rgba(0, 0, 0, 0.35);
      transform: translateY(-2px);
    }
    .gamecard.is-hidden { display: none; }
    .gamecard__bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--s-3);
      margin-bottom: var(--s-3);
    }
    .gamecard__title {
      font-family: var(--face-display);
      font-size: var(--t-md);
      font-weight: 600;
      letter-spacing: var(--tr-snug);
      margin: 0;
    }
    .gamecard__tag {
      flex: none;
      font-family: var(--face-mono);
      font-size: var(--t-2xs);
      text-transform: uppercase;
      letter-spacing: var(--tr-wide);
      color: var(--accent);
      background: var(--accent-wash);
      border-radius: 999px;
      padding: 0.28em 0.7em;
    }
    .gamecard__stage {
      display: flex;
      flex-direction: column;
      gap: var(--s-3);
      align-items: stretch;
    }
    .gamecard__placeholder {
      color: var(--fg-faint);
      font-size: var(--t-sm);
      text-align: center;
      padding: var(--s-6) 0;
      margin: 0;
    }
    .gamecard__how {
