---
import Base from '../layouts/Base.astro';
import { ID, abs, breadcrumb, graph, itemList, person, website } from '../lib/seo';

/**
 * The Surprised arcade: a searchable, paginated gallery of self-contained games
 * that each teach one idea, written so an eight-year-old gets it by playing.
 * Each card leads with a big friendly goal and a plain instruction; the grown-up
 * name and the "why" hide in a details drawer. The games live in
 * src/scripts/surprised.js and mount on demand. English only: nothing to
 * translate but the chrome, and the ideas are the point.
 */

type Cat = 'ml' | 'arch' | 'logic' | 'maths' | 'physics' | 'mind';
type Game = { id: string; title: string; cat: Cat; emoji: string; goal: string; how: string; learn: string; tag: string };

const CATS: Record<Cat, { label: string; emoji: string; blurb: string; c: string; wash: string }> = {
  ml: { label: 'Robot Brains', emoji: '🤖', blurb: 'Teach a computer to learn, one tiny step at a time.', c: '#2f7fe0', wash: 'rgba(47,127,224,0.14)' },
  arch: { label: 'Inside AI', emoji: '🧠', blurb: 'Peek inside chatbots and AI and see how they really work.', c: '#8b5cf6', wash: 'rgba(139,92,246,0.14)' },
  logic: { label: 'Puzzles', emoji: '🧩', blurb: 'Brain-teasers with one clever answer hiding inside.', c: '#12a150', wash: 'rgba(18,161,80,0.14)' },
  maths: { label: 'Numbers', emoji: '🔢', blurb: 'Numbers, shapes, and patterns, turned into games.', c: '#e07b00', wash: 'rgba(224,123,0,0.14)' },
  physics: { label: 'Real World', emoji: '🎈', blurb: 'Gravity, springs, and crashes you can poke and play with.', c: '#e23e6b', wash: 'rgba(226,62,107,0.14)' },
  mind: { label: 'Your Brain', emoji: '👀', blurb: 'Test your memory, your speed, and your eyes.', c: '#d9a520', wash: 'rgba(217,165,32,0.18)' },
};
const CAT_ORDER: Cat[] = ['ml', 'arch', 'logic', 'maths', 'physics', 'mind'];

const GAMES: Game[] = [
  // --- Robot Brains (machine learning) ---
  { id: 'gradient-descent', cat: 'ml', emoji: '🏂', title: 'Rolling Downhill', goal: 'Roll the ball to the very bottom!', how: 'Press Auto-roll. Big steps jump too far.', learn: 'This is how a computer learns: it rolls downhill to the best answer.', tag: 'gradient descent' },
  { id: 'classify', cat: 'ml', emoji: '🍎', title: 'Draw the Line', goal: 'Split the apples from the oranges!', how: 'Move the line, or tap Let it learn.', learn: 'A computer sorts things by drawing a line between them.', tag: 'classification' },
  { id: 'perceptron', cat: 'ml', emoji: '🔵', title: 'One Brain Cell', goal: 'Make the light match the goal!', how: 'Slide the weights, or tap Train.', learn: 'One tiny brain cell adds things up and lights up when the total is big enough.', tag: 'the neuron' },
  { id: 'neural-net', cat: 'ml', emoji: '🧠', title: 'Teach the Brain', goal: 'Watch the brain learn the tricky pattern!', how: 'Press Train and wait a few seconds.', learn: 'Lots of brain cells together learn patterns one cell cannot. This is how AI learns.', tag: 'neural network, backpropagation' },
  { id: 'activation', cat: 'ml', emoji: '〰️', title: 'Bendy Lines', goal: 'See the shape change!', how: 'Pick a shape and slide the dot.', learn: 'Brain cells bend their answers with curves like these.', tag: 'activation functions' },
  { id: 'kmeans', cat: 'ml', emoji: '🎨', title: 'Find the Groups', goal: 'Sort the dots into groups!', how: 'Pick how many groups, then tap Step.', learn: 'A computer can spot groups all by itself, with no help.', tag: 'k-means clustering' },
  { id: 'knn', cat: 'ml', emoji: '👥', title: 'Ask the Neighbours', goal: 'Guess the grey dot’s colour!', how: 'Drag the grey dot around.', learn: 'To guess something new, just ask what is closest to it.', tag: 'k-nearest neighbours' },
  { id: 'overfit', cat: 'ml', emoji: '🎯', title: 'Just Right', goal: 'Find the line that fits just right!', how: 'Slide from simple to wiggly.', learn: 'Too simple misses it. Too wiggly memorises the wrong bits. The middle wins.', tag: 'overfitting' },

  // --- Inside AI (architectures) ---
  { id: 'softmax', cat: 'arch', emoji: '🍰', title: 'Share the Pie', goal: 'Turn the numbers into a pie of chances!', how: 'Slide the numbers and the heat.', learn: 'Computers turn scores into chances that add up to one whole.', tag: 'softmax' },
  { id: 'attention', cat: 'arch', emoji: '👀', title: 'Who Looks at Who', goal: 'See which word looks at which!', how: 'Tap any word.', learn: 'AI reads by letting each word look at the words that matter. That is attention.', tag: 'attention' },
  { id: 'next-token', cat: 'arch', emoji: '✍️', title: 'Finish the Sentence', goal: 'Write a sentence with the robot!', how: 'Tap a word to add it.', learn: 'A chatbot works by guessing the next word, over and over.', tag: 'language model' },
  { id: 'state-space', cat: 'arch', emoji: '🧵', title: 'Memory Belt', goal: 'See the memory remember!', how: 'Press Play, then slide the memory.', learn: 'Some AIs keep one little memory and update it as they read.', tag: 'state space, Mamba' },
  { id: 'model-builder', cat: 'arch', emoji: '🏗️', title: 'Build a Robot Brain', goal: 'Stack blocks and watch the size grow!', how: 'Add blocks. Make them wider.', learn: 'Bigger brains can do more, but cost a lot more to build.', tag: 'parameters, scaling' },
  { id: 'embeddings', cat: 'arch', emoji: '🗺️', title: 'Map of Words', goal: 'Find words that live close together!', how: 'Tap a word. Try the magic button.', learn: 'Words that mean similar things sit near each other on a map.', tag: 'embeddings' },

  // --- Puzzles (logic) ---
  { id: 'lights-out', cat: 'logic', emoji: '💡', title: 'Lights Out', goal: 'Turn off every light!', how: 'Tap a light. Its neighbours flip too.', learn: 'A puzzle about taps that cancel each other out.', tag: 'parity' },
  { id: 'hanoi', cat: 'logic', emoji: '🗼', title: 'Tower Move', goal: 'Move the whole tower to another peg!', how: 'Tap a peg, then another. Big never on small.', learn: 'Move a tower by moving smaller towers first. Neat trick!', tag: 'recursion' },
  { id: 'fifteen', cat: 'logic', emoji: '🔢', title: 'Sliding Puzzle', goal: 'Put the numbers in order!', how: 'Tap a tile next to the empty space.', learn: 'Slide one tile at a time until they line up.', tag: 'planning' },
  { id: 'nim', cat: 'logic', emoji: '🪨', title: 'Last Stone Wins', goal: 'Take the very last stone!', how: 'Tap stones to take them, one pile at a time.', learn: 'A game the computer has completely figured out.', tag: 'game theory' },
  { id: 'mastermind', cat: 'logic', emoji: '🎨', title: 'Secret Colours', goal: 'Guess the 4 hidden colours!', how: 'Pick colours, tap Check. The clues help.', learn: 'Each guess is a clue that gets you closer.', tag: 'deduction' },
  { id: 'logic-gates', cat: 'logic', emoji: '🔌', title: 'Wire the Light', goal: 'Make the light turn on!', how: 'Flip the switches or change the box.', learn: 'Computers are built from tiny switches like AND and OR.', tag: 'boolean logic' },
  { id: 'river-crossing', cat: 'logic', emoji: '🛶', title: 'River Crossing', goal: 'Get everyone across safely!', how: 'Tap a thing to row it over.', learn: 'Sometimes you must take things back to win. Tricky!', tag: 'planning' },
  { id: 'missionaries', cat: 'logic', emoji: '⛵', title: 'Safe Crossing', goal: 'Get all six across, nobody eaten!', how: 'Load the boat, then tap Row.', learn: 'Every move must keep both sides safe.', tag: 'constraints' },
  { id: 'water-jugs', cat: 'logic', emoji: '🫙', title: 'Measure Four', goal: 'Get exactly 4 litres!', how: 'Fill, empty, and pour between the jugs.', learn: 'With a 5 and a 3 you can make a 4. Cool!', tag: 'state search' },
  { id: 'sokoban', cat: 'logic', emoji: '📦', title: 'Push the Boxes', goal: 'Push every box onto a dot!', how: 'Use the arrows. You can only push.', learn: 'Think first! You can never pull a box back.', tag: 'planning' },
  { id: 'sudoku4', cat: 'logic', emoji: '🔡', title: 'Mini Sudoku', goal: 'Every line gets 1, 2, 3, 4!', how: 'Tap a cell to change its number.', learn: 'Each row, column, and box needs all four numbers, once each.', tag: 'constraints' },

  // --- Numbers (maths) ---
  { id: 'primes', cat: 'maths', emoji: '🔎', title: 'Prime Hunt', goal: 'Cross out until only primes are left!', how: 'Tap a number to cross out its multiples.', learn: 'Primes are the numbers left standing. A 2000-year-old trick.', tag: 'number theory' },
  { id: 'times-table', cat: 'maths', emoji: '⚡', title: 'Times Race', goal: 'Get as many right in 30 seconds!', how: 'Tap the right answer, fast.', learn: 'Practise your times tables against the clock.', tag: 'mental maths' },
  { id: 'fractions', cat: 'maths', emoji: '🍕', title: 'Pizza Fractions', goal: 'Match the slice to the fraction!', how: 'Tap the matching fraction.', learn: 'A fraction is just a slice of a whole thing.', tag: 'fractions' },
  { id: 'guess-line', cat: 'maths', emoji: '📈', title: 'Fit the Line', goal: 'Thread the line through the dots!', how: 'Slide to tilt and lift the line.', learn: 'Find the line that best follows the dots.', tag: 'algebra' },
  { id: 'estimate', cat: 'maths', emoji: '👁️', title: 'Guess How Many', goal: 'Guess the number of dots!', how: 'Watch them flash, then guess.', learn: 'You can feel roughly how many without counting.', tag: 'number sense' },
  { id: 'pattern', cat: 'maths', emoji: '🔢', title: 'What Comes Next', goal: 'Find the next number!', how: 'Spot the pattern, then tap the answer.', learn: 'Find the rule and you find the next number.', tag: 'sequences' },
  { id: 'angle', cat: 'maths', emoji: '📐', title: 'Point It', goal: 'Aim the arrow at the dot!', how: 'Slide to turn the arrow.', learn: 'Angles measure turning. Ninety is a corner.', tag: 'geometry' },
  { id: 'derivative', cat: 'maths', emoji: '⛰️', title: 'The Slope', goal: 'Find the flat spot on the hill!', how: 'Slide the dot along the hill.', learn: 'The slope shows which way is uphill. Flat means the top or bottom.', tag: 'calculus' },
  { id: 'integral', cat: 'maths', emoji: '📊', title: 'Fill the Space', goal: 'Fill under the curve with blocks!', how: 'Add more and more blocks.', learn: 'Lots of thin blocks add up to the space under a curve.', tag: 'calculus' },
  { id: 'vectors', cat: 'maths', emoji: '➡️', title: 'Two Arrows', goal: 'Make the arrows point apart!', how: 'Drag the tips of the arrows.', learn: 'The dot product tells how much two arrows agree.', tag: 'linear algebra' },
  { id: 'matrix', cat: 'maths', emoji: '🔷', title: 'Bend the Grid', goal: 'Spin and squish the square!', how: 'Slide the numbers, or tap a preset.', learn: 'Four numbers can rotate and stretch a whole picture.', tag: 'linear algebra' },

  // --- Real World (physics) ---
  { id: 'projectile', cat: 'physics', emoji: '🎯', title: 'Cannon', goal: 'Hit the target!', how: 'Set the angle and power, then Fire.', learn: 'Gravity bends the ball into a curve.', tag: 'projectiles' },
  { id: 'orbit', cat: 'physics', emoji: '🪐', title: 'Orbits', goal: 'Make the planet loop the star!', how: 'Drag and let go to fling it.', learn: 'An orbit is falling forever and always missing.', tag: 'gravity' },
  { id: 'pendulum', cat: 'physics', emoji: '🕰️', title: 'Swings', goal: 'See which one swings slower!', how: 'Set the lengths, then release.', learn: 'Longer swings are slower. The weight does not matter.', tag: 'oscillation' },
  { id: 'incline', cat: 'physics', emoji: '🛝', title: 'The Ramp', goal: 'Roll the ball down!', how: 'Change the steepness, then drop it.', learn: 'A steeper ramp means a faster roll.', tag: 'acceleration' },
  { id: 'bounce', cat: 'physics', emoji: '🏀', title: 'Bounce Box', goal: 'Fling the balls around!', how: 'Drag to throw a ball. Add more.', learn: 'Balls swap their speed when they bump.', tag: 'collisions' },
  { id: 'balance', cat: 'physics', emoji: '⚖️', title: 'Balance', goal: 'Balance the see-saw!', how: 'Tap left or right to drop a weight.', learn: 'Weights far from the middle push harder than near ones.', tag: 'torque' },
  { id: 'spring', cat: 'physics', emoji: '🪀', title: 'Springy', goal: 'Make the block bounce!', how: 'Drag the block aside and let go.', learn: 'A stiffer spring bounces faster.', tag: 'oscillation' },
  { id: 'collide', cat: 'physics', emoji: '🚕', title: 'Cart Crash', goal: 'Smash the carts together!', how: 'Set the weights, then Launch.', learn: 'A heavy cart barely moves when a light one hits it.', tag: 'momentum' },

  // --- Your Brain (mind) ---
  { id: 'simon', cat: 'mind', emoji: '🎵', title: 'Simon Says', goal: 'Repeat the pattern!', how: 'Watch it, then tap it back.', learn: 'It gets one longer every time. How far can you go?', tag: 'memory' },
  { id: 'memory-match', cat: 'mind', emoji: '🃏', title: 'Memory Match', goal: 'Find all the matching pairs!', how: 'Flip two cards. A match stays.', learn: 'Remember where each picture is hiding.', tag: 'recall' },
  { id: 'reaction', cat: 'mind', emoji: '⏱️', title: 'Fast Tap', goal: 'Tap the moment it turns green!', how: 'Wait for green, then tap fast.', learn: 'People take about a fifth of a second to react.', tag: 'reflex' },
  { id: 'stroop', cat: 'mind', emoji: '🌈', title: 'Colour Trick', goal: 'Tap the ink colour, not the word!', how: 'Look at the colour, ignore the word.', learn: 'Your brain wants to read the word. Tricky!', tag: 'attention' },
  { id: 'binary', cat: 'mind', emoji: '🔟', title: 'Robot Numbers', goal: 'Make the target number!', how: 'Flip switches so they add up.', learn: 'Computers count with just on and off.', tag: 'binary' },
];

const COUNT = GAMES.length;
const searchStr = (g: Game) => `${g.title} ${g.goal} ${g.tag} ${CATS[g.cat].label} ${g.learn} ${g.how}`.toLowerCase();

const DESCRIPTION =
  'Dozens of easy little games that each teach one big idea, from fractions to teaching a robot ' +
  'brain to learn. Simple enough for a kid. Free, no install.';

const KEYWORDS = [
  'games for kids',
  'learning games',
  'machine learning for kids',
  'how AI works',
  'neural network game',
  'educational games',
  'physics games',
  'math games',
  'logic puzzles',
  'learn by playing',
] as const;

const url = abs('/surprised/');
const surprisedSchema = graph(
  person(),
  website(),
  {
    '@type': ['CollectionPage', 'WebApplication'],
    '@id': url,
    url,
    name: 'Surprised: little games that teach',
    description: DESCRIPTION,
    inLanguage: 'en',
    isPartOf: { '@id': ID.website },
    author: { '@id': ID.person },
    applicationCategory: 'GameApplication',
    operatingSystem: 'Any modern web browser',
    browserRequirements: 'Requires JavaScript',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    audience: { '@type': 'EducationalAudience', educationalRole: 'student' },
    keywords: KEYWORDS.join(', '),
    breadcrumb: { '@id': `${url}#breadcrumb` },
    mainEntity: { '@id': `${url}#list` },
  },
  breadcrumb([
    { name: 'Home', url: '/' },
    { name: 'Surprised', url: '/surprised/' },
  ]),
  itemList(
    url,
    GAMES.map((g) => ({ name: g.title, url: `/surprised/#game-${g.id}` })),
    {
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      itemListElement: GAMES.map((g, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'Game',
          name: g.title,
          description: `${g.goal} ${g.learn}`,
          url: `${url}#game-${g.id}`,
          author: { '@id': ID.person },
          genre: g.tag,
          about: CATS[g.cat].label,
        },
      })),
    },
  ),
);
---

<Base
  title="Surprised"
  description={DESCRIPTION}
  keywords={KEYWORDS}
  schema={surprisedSchema}
  available={['en']}
>
  <div class="surprised wrap page">
    <header class="page__head arcade-hero">
      <p class="label">A surprise arcade &nbsp;·&nbsp; {COUNT} little games</p>
      <h1 class="display page__title">Surprised</h1>
      <p class="lede page__lede">
        You found the secret arcade! Every game is tiny, and every one teaches a big idea by letting you
        play with it. Pop bubbles of maths, bend gravity, and even teach a robot brain to learn, no
        reading required. Tap a game and go.
      </p>
    </header>

    <div class="arcade-controls" role="search">
      <div class="arcade-search-wrap">
        <svg class="arcade-search-icon" viewBox="0 0 20 20" aria-hidden="true" width="18" height="18">
          <circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="2"></circle>
          <line x1="13.5" y1="13.5" x2="18" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
        </svg>
        <input
          id="arcade-search"
          class="arcade-search"
          type="search"
          placeholder="Find a game..."
          aria-label="Search games"
          autocomplete="off"
        />
      </div>
      <div class="arcade-chips" role="tablist" aria-label="Pick a kind of game">
        <button type="button" class="arcade-chip" data-cat="all" data-label="All games" aria-pressed="true">All</button>
        {CAT_ORDER.map((key) => (
          <button type="button" class="arcade-chip" data-cat={key} data-label={CATS[key].label} aria-pressed="false">
            {CATS[key].label}
          </button>
        ))}
      </div>
    </div>

    <div class="arcade-bar">
      <h2 class="arcade-section" id="arcade-heading">All games</h2>
      <span class="arcade-count tnum" id="arcade-count">{COUNT} games</span>
    </div>

    <div class="arcade-grid" id="arcade-grid">
      {
        GAMES.map((game) => (
          <article
            class="gamecard game"
            id={`game-${game.id}`}
            data-game={game.id}
            data-cat={game.cat}
            data-search={searchStr(game)}
            style={`--cat:${CATS[game.cat].c};--catwash:${CATS[game.cat].wash}`}
          >
            <div class="gamecard__bar">
              <span class="gamecard__emoji" aria-hidden="true">{game.emoji}</span>
              <h3 class="gamecard__title">{game.title}</h3>
              <span class="gamecard__pill">{CATS[game.cat].label}</span>
            </div>
            <p class="gamecard__goal">{game.goal}</p>
            <div class="gamecard__stage" data-stage>
              <p class="gamecard__placeholder">Loading…</p>
            </div>
            <p class="gamecard__how"><span class="gamecard__how-k">How</span> {game.how}</p>
            <details class="gamecard__learn">
              <summary>Why it is cool</summary>
              <p>{game.learn}</p>
              <p class="gamecard__grown">Grown-up name: {game.tag}</p>
            </details>
          </article>
        ))
      }
    </div>

    <p class="arcade-empty" id="arcade-empty" hidden>
      No game matches that. Try another word, or tap <strong>All</strong>.
    </p>

    <nav class="arcade-pager" id="arcade-pager" aria-label="Pages"></nav>

    <footer class="arcade-foot">
      <p>
        Every game is a few dozen lines of plain code, no libraries, made to be small and easy. Only twelve
        show at a time, so it stays light; search or pick a colour to find the rest. If one breaks on your
        screen, that is a bug worth an email.
      </p>
    </footer>
  </div>

  <script>
    import '../scripts/surprised.js';
  </script>

  <style>
    /* --- page shell -------------------------------------------------------- */
    .arcade-hero { max-width: var(--measure); }

    .arcade-controls {
      display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-4); align-items: center;
      margin-top: var(--s-7); padding-bottom: var(--s-4);
    }
    .arcade-search-wrap { position: relative; flex: 1 1 16rem; min-width: 12rem; display: flex; align-items: center; }
    .arcade-search-icon { position: absolute; inset-inline-start: 0.8rem; color: var(--fg-faint); pointer-events: none; }
    .arcade-search {
      width: 100%; font: inherit; font-size: var(--t-base); color: var(--fg);
      background: var(--bg-sunken); border: 2px solid var(--rule); border-radius: 999px;
      padding: 0.7em 1em 0.7em 2.6em; transition: border-color var(--dur-fast) var(--ease);
    }
    .arcade-search:focus-visible { outline: none; border-color: var(--accent); }
    .arcade-chips { display: flex; flex-wrap: wrap; gap: var(--s-2); }
    .arcade-chip {
      font: inherit; font-size: var(--t-sm); font-weight: 600; cursor: pointer;
      color: var(--fg-muted); background: var(--bg-sunken); border: 2px solid transparent;
      border-radius: 999px; padding: 0.45em 0.9em;
      transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
    }
    .arcade-chip:hover { border-color: var(--rule-strong); }
    .arcade-chip[aria-pressed='true'] { color: #fff; background: var(--accent); border-color: var(--accent); }

    .arcade-bar {
      display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-3);
      border-top: var(--rule-w) solid var(--rule); padding-top: var(--s-4); margin-bottom: var(--s-5);
    }
    .arcade-section { margin: 0; font-family: var(--face-display); font-size: var(--t-lg); font-weight: 600; }
    .arcade-count { color: var(--fg-faint); font-size: var(--t-sm); font-family: var(--face-mono); }

    .arcade-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
      gap: var(--s-5); scroll-margin-top: var(--s-5);
    }

    .gamecard {
      display: flex; flex-direction: column;
      border: var(--rule-w) solid var(--rule); border-top: 5px solid var(--cat, var(--accent));
      border-radius: 16px; background: var(--bg); padding: var(--s-4) var(--s-4) var(--s-5);
      scroll-margin-top: var(--s-6);
      transition: box-shadow var(--dur) var(--ease), transform var(--dur) var(--ease);
    }
    .gamecard:hover { box-shadow: 0 12px 34px -18px rgba(0, 0, 0, 0.4); transform: translateY(-3px); }
    .gamecard.is-hidden { display: none; }
    .gamecard__bar { display: flex; align-items: center; gap: var(--s-2); margin-bottom: var(--s-2); }
    .gamecard__emoji { font-size: 1.6rem; line-height: 1; }
    .gamecard__title {
      font-family: var(--face-display); font-size: var(--t-lg); font-weight: 700;
      letter-spacing: var(--tr-snug); margin: 0; flex: 1 1 auto;
    }
    .gamecard__pill {
      flex: none; font-size: var(--t-2xs); font-weight: 700;
      color: var(--cat, var(--accent)); background: var(--catwash, var(--accent-wash));
      border-radius: 999px; padding: 0.32em 0.7em; white-space: nowrap;
    }
    .gamecard__goal {
      margin: 0 0 var(--s-3); font-family: var(--face-display); font-size: var(--t-md);
      font-weight: 600; color: var(--fg-strong); line-height: var(--lh-snug);
    }
    .gamecard__stage { display: flex; flex-direction: column; gap: var(--s-3); align-items: stretch; }
    .gamecard__placeholder { color: var(--fg-faint); font-size: var(--t-sm); text-align: center; padding: var(--s-6) 0; margin: 0; }
    .gamecard__how {
      margin: var(--s-4) 0 0; font-size: var(--t-base); color: var(--fg); line-height: var(--lh-snug);
    }
    .gamecard__how-k {
      font-family: var(--face-mono); font-size: var(--t-2xs); font-weight: 700;
      text-transform: uppercase; letter-spacing: var(--tr-wide); color: var(--cat, var(--accent));
      margin-inline-end: 0.3em;
    }
    .gamecard__learn { margin-top: var(--s-3); font-size: var(--t-sm); }
    .gamecard__learn summary {
