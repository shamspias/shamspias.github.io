---
import Base from '../../layouts/Base.astro';
import { allPosts, groupBySeries, shortDate, slugifyTag, urlOf } from '../../lib/posts';

const posts = await allPosts();
const series = groupBySeries(posts);

const BLURBS: Record<string, string> = {
  'Agent Harness':
    'The layer between a language model and software that already exists: what to expose, how to keep it safe, and how to store an agent so it can be changed without a deploy.',
  'Machine Learning for Biology':
    'From what a peptide is, through the descriptor zoo and protein language models, to screening four hundred thousand natural products and docking the survivors.',
  'Vision in the Real World':
    'Pose estimation and image models pointed at problems that pay: a bowling action, a clinical record, a diseased field seen from a drone.',
  'Mixture of Experts':
    'How sparse expert models route a token, and what to do about the one expert that holds everyone else up.',
  'Retrieval and RAG':
    'Which retrieval numbers actually matter, and a reproducible way to find out which stack to build on.',
  'AI Foundations':
    'A run through the classical ground: linear algebra, search, adversarial search, constraint satisfaction, logic, and planning. Written for someone starting from nothing.',
};
---

<Base
  title="Series"
  description="Multi-part runs on agent harnesses, machine learning for biology, computer vision, mixture-of-experts models, retrieval, and the classical AI foundations."
>
  <div class="wrap page">
    <header class="page__head">
      <p class="label">{series.length} runs &nbsp;·&nbsp; {series.reduce((n, s) => n + s.posts.length, 0)} posts</p>
      <h1 class="display page__title">Series</h1>
      <p class="lede page__lede">
        Most of what I write belongs to a run rather than standing alone. Read a series in order and
        it works like a short book; read one part and it still stands up.
      </p>
    </header>

    <div class="runs">
      {
        series.map((s) => (
          <section class="run">
            <div class="run__head">
              <h2 class="run__title">
                <a href={`/series/${slugifyTag(s.name)}/`}>{s.name}</a>
              </h2>
              <p class="run__count label tnum">
                {String(s.posts.length).padStart(2, '0')} parts
              </p>
            </div>
            {BLURBS[s.name] && <p class="run__blurb">{BLURBS[s.name]}</p>}
            <ol class="run__list">
              {s.posts.map((p) => (
                <li class="run__item">
                  <span class="run__n label tnum">
                    {String(p.data.seriesOrder ?? 0).padStart(2, '0')}
                  </span>
                  <a class="run__link" href={urlOf(p)}>{p.data.title}</a>
                  <time class="run__date label tnum" datetime={p.data.date.toISOString().slice(0, 10)}>
                    {shortDate(p.data.date)}
                  </time>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .page {
    padding-block: var(--s-8) var(--s-6);
  }

  .page__head {
    max-width: 56ch;
    margin-bottom: var(--s-8);
  }

  .page__title {
    font-size: var(--t-2xl);
    margin-block: var(--s-3) var(--s-4);
  }

  .page__lede {
    max-width: 52ch;
  }

  .runs {
    display: grid;
    gap: var(--s-9);
  }

  .run {
    max-width: 76ch;
  }

  .run__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
    padding-bottom: var(--s-3);
    border-bottom: var(--rule-w) solid var(--rule-strong);
  }

  .run__title {
    font-family: var(--face-display);
    font-size: var(--t-xl);
    font-weight: 500;
    letter-spacing: var(--tr-snug);
    line-height: var(--lh-snug);
  }

  .run__title a {
    color: var(--fg-strong);
    text-decoration: none;
  }

  .run__title a:hover {
    color: var(--accent);
  }

  .run__count {
    color: var(--fg-faint);
    white-space: nowrap;
  }

  .run__blurb {
    margin-top: var(--s-4);
    color: var(--fg-muted);
    max-width: 62ch;
    text-wrap: pretty;
  }

  .run__list {
    list-style: none;
    margin: var(--s-5) 0 0;
    padding: 0;
  }

  .run__item {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: var(--s-1) var(--s-3);
    align-items: baseline;
    padding-block: var(--s-3);
    border-bottom: var(--rule-w) solid var(--rule);
  }

  .run__item:last-child {
    border-bottom: 0;
  }

  .run__n {
    color: var(--accent);
  }

  .run__link {
    font-family: var(--face-display);
    font-size: var(--t-base);
    color: var(--fg-strong);
    text-decoration-color: var(--rule-strong);
    text-wrap: pretty;
  }

  .run__link:hover {
    color: var(--accent);
  }

  .run__date {
    grid-column: 2;
    color: var(--fg-faint);
  }

  @media (min-width: 46rem) {
    .run__item {
      grid-template-columns: 2.25rem minmax(0, 1fr) 6.5rem;
    }

    .run__date {
      grid-column: 3;
      text-align: right;
    }
  }
</style>
