---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PostEntry from '../../components/PostEntry.astro';
import { allPosts, groupBySeries, plainTitle, slugifyTag, urlOf } from '../../lib/posts';
import { ID, abs, breadcrumb, clamp, graph, itemList, person, website } from '../../lib/seo';

export const getStaticPaths = (async () => {
  const posts = await allPosts();
  return groupBySeries(posts).map((s) => ({
    params: { series: slugifyTag(s.name) },
    props: { name: s.name, posts: s.posts },
  }));
}) satisfies GetStaticPaths;

const { name, posts } = Astro.props;
const first = posts[0];
const last = posts[posts.length - 1];
const span =
  first && last && first !== last
    ? `${first.data.date.getUTCFullYear()}–${last.data.date.getUTCFullYear()}`
    : `${first?.data.date.getUTCFullYear() ?? ''}`;

const url = `/series/${slugifyTag(name)}/`;
const subjects = [...new Set(posts.flatMap((p) => p.data.tags))];

// Trimmed to fit a snippet: the series name, its length, and the first line of
// what it is actually about.
const opening = posts[0]?.data.description ?? '';
const description = clamp(
  `${name}: ${posts.length} parts in reading order, by Shamsuddin Ahmed. ${opening}`,
);

const id = abs(url);
const schema = graph(
  person(),
  website(),
  {
    '@type': ['CollectionPage', 'CreativeWorkSeries'],
    '@id': id,
    url: id,
    name,
    description,
    inLanguage: 'en',
    isPartOf: { '@id': ID.website },
    author: { '@id': ID.person },
    publisher: { '@id': ID.person },
    numberOfItems: posts.length,
    about: subjects.map((t) => ({ '@type': 'Thing', name: t })),
    keywords: subjects.join(', '),
    breadcrumb: { '@id': `${id}#breadcrumb` },
    mainEntity: { '@id': `${id}#list` },
    ...(first ? { startDate: first.data.date.toISOString().slice(0, 10) } : {}),
    ...(last ? { endDate: last.data.date.toISOString().slice(0, 10) } : {}),
  },
  breadcrumb([
    { name: 'Home', url: '/' },
    { name: 'Series', url: '/series/' },
    { name, url },
  ]),
  // A series reads forwards, so the list is ascending, unlike every other index
  // on the site.
  itemList(
    id,
    posts.map((p) => ({ name: plainTitle(p.data.title), url: urlOf(p) })),
    { itemListOrder: 'https://schema.org/ItemListOrderAscending' },
  ),
);
---

<Base title={name} description={description} keywords={subjects} schema={schema}>
  <div class="wrap page">
    <header class="page__head">
      <p class="label">
        Series &nbsp;·&nbsp; {posts.length} parts &nbsp;·&nbsp; <span class="tnum">{span}</span>
      </p>
      <h1 class="display page__title">{name}</h1>
      <p class="lede page__lede">Written to be read in order, and to stand up out of it.</p>
    </header>

    <div class="list">
      {posts.map((post) => <PostEntry post={post} variant="card" />)}
    </div>

    <p class="page__back">
      <a href="/series/">All series</a>
      <span class="page__sep" aria-hidden="true"></span>
      <a href="/writing/">All writing</a>
    </p>
  </div>
</Base>

<style>
  .page {
    padding-block: var(--s-8) var(--s-6);
  }

  .page__head {
    max-width: 56ch;
    margin-bottom: var(--s-7);
  }

  .page__title {
    font-size: var(--t-2xl);
    margin-block: var(--s-3) var(--s-4);
  }

  .page__lede {
    max-width: 52ch;
  }

  .list {
    border-top: var(--rule-w) solid var(--rule-strong);
    max-width: 76ch;
  }

  .page__back {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-7);
    font-size: var(--t-sm);
  }

  .page__back a {
    color: var(--fg-strong);
    text-decoration-color: var(--accent);
  }

  .page__back a:hover {
    color: var(--accent);
  }

  .page__sep {
    width: var(--s-5);
    border-top: var(--rule-w) solid var(--rule-strong);
  }
</style>
