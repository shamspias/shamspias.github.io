---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PostEntry from '../../components/PostEntry.astro';
import portrait from '../../assets/shamsuddin-ahmed.png';
import { SITE } from '../../consts';
import { allPosts, groupBySeries, plainTitle, slugifyTag, urlOf } from '../../lib/posts';
import { ID, abs, breadcrumb, graph, itemList, person, website } from '../../lib/seo';
import { localePaths, localise, t, type Locale } from '../../i18n';
import { HOME } from '../../i18n/content/home';

export const getStaticPaths = (() => localePaths()) satisfies GetStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const strings = t(locale);
const home = HOME[locale];

const posts = await allPosts(locale);
const recent = posts.slice(0, 6);
const series = groupBySeries(posts);

// The thread links point at series pages, and a series page exists in a language
// only where that language has parts of it. Where it does not, the link goes to
// the English page and says so, rather than at an address that was never built.
const seriesSlugs = new Set(series.map((s) => slugifyTag(s.name)));
const linkFor = (href: string) => {
  if (href.startsWith('http')) return { href, foreign: false };
  const slug = href.startsWith('/series/') ? href.slice('/series/'.length).replace(/\/$/, '') : null;
  if (slug && !seriesSlugs.has(slug)) return { href, foreign: locale !== 'en' };
  return { href: localise(href, locale), foreign: false };
};

// One graph, so the person, the site and this page are stated once and pointed
// at from every other page rather than repeated with slight differences.
const schema = graph(
  person(),
  website(),
  {
    '@type': 'ProfilePage',
    '@id': abs(localise('/', locale)),
    url: abs(localise('/', locale)),
    name: `${SITE.name} · ${strings.role}`,
    description: strings.siteDescription,
    inLanguage: locale,
    isPartOf: { '@id': ID.website },
    mainEntity: { '@id': ID.person },
    about: { '@id': ID.person },
    breadcrumb: { '@id': `${abs(localise('/', locale))}#breadcrumb` },
    hasPart: { '@id': `${abs(localise('/', locale))}#list` },
    image: {
      '@type': 'ImageObject',
      url: new URL(portrait.src, SITE.url).href,
      width: portrait.width,
      height: portrait.height,
      caption: `${SITE.name}, ${strings.role}`,
    },
  },
  breadcrumb([{ name: strings.home, url: localise('/', locale) }]),
  itemList(
    abs(localise('/', locale)),
    recent.map((p) => ({ name: plainTitle(p.data.title), url: urlOf(p) })),
  ),
)
---

<Base title={SITE.name} description={strings.siteDescription} schema={schema} locale={locale}>
  {/* --- masthead ------------------------------------------------------- */}
  <section class="wrap hero">
    <div class="hero__body">
      <p class="label hero__meta">{strings.role} &nbsp;·&nbsp; {home.location}</p>
      <h1 class="display hero__title">{home.heroTitle}</h1>
      <div class="hero__prose stack">
        <p>{home.heroProse}</p>
        <p class="hero__cta">
          <a href={localise('/writing/', locale)}>{home.ctaWriting}</a>
          <span class="hero__sep" aria-hidden="true"></span>
          <a href="/projects/" hreflang="en">{home.ctaProjects}</a>
          <span class="hero__sep" aria-hidden="true"></span>
          <a href="https://github.com/shamspias" rel="me noopener">GitHub</a>
        </p>
      </div>
    </div>

    <figure class="hero__portrait">
      <Image
        src={portrait}
        alt={home.portraitAlt}
        widths={[220, 340, 468]}
        sizes="(min-width: 64rem) 17rem, (min-width: 46rem) 13rem, 8.5rem"
        loading="eager"
        fetchpriority="high"
      />
    </figure>
  </section>

  {/* --- what I'm working on ------------------------------------------- */}
  <section class="bleed"><div class="wrap section">
    <h2 class="eyebrow section__head" id="now">{home.sectionNow}</h2>
    <ul class="roles">
      {
        home.now.map((r) => (
          <li class="role">
            <p class="role__when label tnum">{r.when}</p>
            <div class="role__body">
              <h3 class="role__title">
                {r.role}
                {strings.comma}
                {r.href ? (
                  <a href={r.href} rel="noopener">
                    {r.org}
                  </a>
                ) : (
                  r.org
                )}
              </h3>
              <p class="role__what">{r.what}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div></section>

  {/* --- the three threads --------------------------------------------- */}
  <section class="bleed"><div class="wrap section">
    <h2 class="eyebrow section__head" id="threads">{home.sectionThreads}</h2>
    <ol class="threads">
      {
        home.threads.map((thread) => (
          <li class="thread">
            <p class="thread__n label tnum">{thread.n}</p>
            <div class="thread__body">
              <h3 class="thread__title">{thread.title}</h3>
              <p class="thread__what">{thread.body}</p>
              <p class="thread__links">
                {thread.links.map((l) => {
                  const link = linkFor(l.href);
                  return (
                    <a
                      href={link.href}
                      hreflang={link.foreign ? 'en' : undefined}
                      rel={l.href.startsWith('http') ? 'noopener' : undefined}
                    >
                      {l.label}
                    </a>
                  );
                })}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div></section>

  {/* --- recent writing ------------------------------------------------- */}
  <section class="bleed"><div class="wrap section">
    <h2 class="eyebrow section__head" id="recent">{home.sectionRecent}</h2>
    <div class="recent">
      {recent.map((post) => <PostEntry post={post} variant="card" />)}
    </div>
    <p class="section__more">
      <a href={localise('/writing/', locale)}>{home.allPosts(strings.nPosts(posts.length))}</a>
      <span class="hero__sep" aria-hidden="true"></span>
      <a href={localise('/series/', locale)}>{home.seriesLink(strings.nSeries(series.length))}</a>
    </p>
  </div></section>
</Base>

<style>
  /* --- masthead ------------------------------------------------------- */

  .hero {
    display: grid;
    gap: var(--s-6);
    padding-block: var(--s-8) var(--s-9);
    grid-template-columns: minmax(0, 1fr);
  }

  .hero__meta {
    color: var(--fg-faint);
    margin-bottom: var(--s-4);
  }

  .hero__title {
    font-size: var(--t-2xl);
    max-width: 30ch;
    margin-bottom: var(--s-5);
  }

  .hero__prose {
    --flow: var(--s-4);
    max-width: 58ch;
    color: var(--fg-muted);
  }

  .hero__cta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-3);
    font-size: var(--t-sm);
  }

  .hero__cta a {
    color: var(--fg-strong);
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
  }

  .hero__cta a:hover {
    color: var(--accent);
  }

  /* A hairline rather than a bullet or a slash. Quieter, and it belongs to the
     same family as every other separator on the site. */
  .hero__sep {
    width: var(--s-5);
    border-top: var(--rule-w) solid var(--rule-strong);
  }

  .hero__portrait {
    margin: 0;
    width: 8.5rem;
    order: -1;
  }

  /* A cut-out betrays itself at the bottom, where the crop slices straight
     through the jacket and the figure sits on the page like a sticker. The fix
     is not a better matte: it is to stop the image ending.

     Two things make that work. The source PNG carries 30% empty canvas below
     the figure, so the fade has somewhere to finish; without it the gradient
     has to complete inside the jacket and the crop line and the end of the fade
     land on the same row, which is the straight edge you were seeing. And the
     gradient is eased over five stops rather than linear over two, because a
     linear ramp reads as a band while an eased one reads as depth.

     Sides and shoulders stay crisp. Those edges are real. */
  .hero__portrait :global(img) {
    width: 100%;
    filter: saturate(0.82) contrast(1.04);
    /* The figure occupies the top 75% of this canvas, so the crop through the
       jacket sits at 75%. The ramp therefore has to reach zero BEFORE that, not
       after it: a fade that is still 76% opaque where the jacket ends leaves
       exactly the straight edge it was meant to hide. Solid to 34%, gone by
       70%, five stops so it reads as depth rather than as a band. */
    --fade:
      linear-gradient(
        to bottom,
        #000 0%,
        #000 34%,
        rgba(0, 0, 0, 0.92) 44%,
        rgba(0, 0, 0, 0.66) 53%,
        rgba(0, 0, 0, 0.34) 61%,
        rgba(0, 0, 0, 0.10) 66%,
        transparent 70%
      );
    -webkit-mask-image: var(--fade);
    mask-image: var(--fade);
  }

  /* On the dark ground the figure needs lifting off a near-black page. A flat
     brightness() would do it, but it also lifts the matte's semi-transparent
     edge pixels and draws a faint rectangle around the whole plate, so the
     lift is done with contrast and a small gamma instead. */
  :global(:root[data-theme='dark']) .hero__portrait :global(img) {
    filter: saturate(0.8) contrast(1.06);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .hero__portrait :global(img) {
      filter: saturate(0.8) contrast(1.06);
    }
  }

  @media (min-width: 46rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: clamp(var(--s-6), 5vw, var(--s-9));
      align-items: start;
      padding-block: var(--s-9);
    }

    .hero__portrait {
      order: 0;
      width: 13rem;
      position: sticky;
      top: var(--s-6);
    }
  }

  @media (min-width: 64rem) {
    .hero__portrait {
      width: 17rem;
    }
  }

  /* --- sections ------------------------------------------------------- */

  .section {
    padding-block: var(--s-8);
  }

  .section__head {
    margin-bottom: var(--s-6);
  }

  .section__more {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
    font-size: var(--t-sm);
  }

  .section__more a {
    color: var(--fg-strong);
    text-decoration-color: var(--accent);
  }

  .section__more a:hover {
    color: var(--accent);
  }

  /* --- roles and threads share one two-column rhythm ------------------ */

  .roles,
  .threads {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-6);
  }

  .role,
  .thread {
    display: grid;
    gap: var(--s-2);
  }

  .role__when,
  .thread__n {
    color: var(--fg-faint);
    padding-top: 0.4em;
  }

  .thread__n {
    color: var(--accent);
  }

  .role__title,
  .thread__title {
    font-family: var(--face-display);
    font-size: var(--t-lg);
    font-weight: 500;
    letter-spacing: var(--tr-snug);
    color: var(--fg-strong);
    line-height: var(--lh-snug);
  }

  .role__title a {
    text-decoration-color: var(--accent);
  }

  .role__title a:hover {
    color: var(--accent);
  }

  .role__what,
  .thread__what {
    color: var(--fg-muted);
    max-width: 62ch;
    margin-top: var(--s-2);
    text-wrap: pretty;
  }

  .thread__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    margin-top: var(--s-3);
    font-size: var(--t-sm);
  }

  .thread__links a {
    color: var(--fg-muted);
    text-decoration-color: var(--rule-strong);
  }

  .thread__links a:hover {
    color: var(--accent);
  }

  @media (min-width: 46rem) {
    .role,
    .thread {
      grid-template-columns: 7.5rem minmax(0, 1fr);
      column-gap: var(--s-5);
      align-items: baseline;
    }

    .roles,
    .threads {
      gap: var(--s-7);
    }
  }

  /* --- recent --------------------------------------------------------- */

  .recent {
    border-top: var(--rule-w) solid var(--rule-strong);
  }
</style>
