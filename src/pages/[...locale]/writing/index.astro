---
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import PostEntry from '../../../components/PostEntry.astro';
import { allPosts, byYear, groupBySeries, plainTitle, slugifyTag, tagCounts, urlOf } from '../../../lib/posts';
import { ID, abs, breadcrumb, graph, itemList, person, website } from '../../../lib/seo';
import { localePaths, localise, t, yearIn, type Locale } from '../../../i18n';
import { tagLabel } from '../../../i18n/tags';

export const getStaticPaths = (() => localePaths()) satisfies GetStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const strings = t(locale);

const posts = await allPosts(locale);
const years = byYear(posts);
const series = groupBySeries(posts);
const tags = tagCounts(posts).slice(0, 14);

const subjects = tagCounts(posts).slice(0, 20).map((s) => s.tag);
const url = localise('/writing/', locale);
const id = abs(url);
const description = strings.writingDesc;

// The blog node is the one every post points back at with isPartOf, which is
// what ties thirty-nine separate articles together into one body of work.
const schema = graph(
  person(),
  website(),
  {
    '@type': 'Blog',
    '@id': locale === 'en' ? ID.blog : `${id}#blog`,
    url: id,
    name: `${strings.writing} · Shamsuddin Ahmed`,
    description,
    inLanguage: 'en',
    isPartOf: { '@id': ID.website },
    author: { '@id': ID.person },
    publisher: { '@id': ID.person },
    keywords: subjects.join(', '),
    about: subjects.map((t) => ({ '@type': 'Thing', name: t })),
    breadcrumb: { '@id': `${id}#breadcrumb` },
    blogPost: posts.slice(0, 20).map((p) => ({
      '@type': 'BlogPosting',
      '@id': abs(urlOf(p)),
      headline: plainTitle(p.data.title),
      url: abs(urlOf(p)),
      datePublished: p.data.date.toISOString(),
      author: { '@id': ID.person },
    })),
  },
  breadcrumb([
    { name: strings.home, url: localise('/', locale) },
    { name: strings.writing, url },
  ]),
  itemList(
    id,
    posts.map((p) => ({ name: plainTitle(p.data.title), url: urlOf(p) })),
  ),
);
---

<Base
  title={strings.writing}
  description={description}
  keywords={subjects}
  schema={schema}
  locale={locale}
>
  <div class="wrap page">
    <header class="page__head">
      <p class="label">
        {strings.nPosts(posts.length)} &nbsp;·&nbsp; {strings.nYears(years.length)}
      </p>
      <h1 class="display page__title">{strings.writing}</h1>
      <p class="lede page__lede">{strings.writingLede}</p>
    </header>

    {/* At wide viewports the index gets a stationary margin column carrying the
        series and tag indexes. Below that they sit above the list, collapsed. */}
    <div class="page__grid">
      <aside class="rail" aria-label={strings.browseAria}>
        <nav class="rail__block">
          <h2 class="label rail__head">{strings.series}</h2>
          <ul class="rail__list">
            {
              series.map((s) => (
                <li>
                  <a href={localise(`/series/${slugifyTag(s.name)}/`, locale)}>
                    {s.name}
                    <span class="rail__n tnum">{s.posts.length}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <nav class="rail__block">
          <h2 class="label rail__head">{strings.subjects}</h2>
          <ul class="rail__list rail__list--inline">
            {
              tags.map((tag) => (
                <li>
                  <a href={localise(`/tags/${tag.slug}/`, locale)}>
                    {tagLabel(tag.tag, locale)}
                    <span class="rail__n tnum">{tag.count}</span>
                  </a>
                </li>
              ))
            }
            <li>
              <a href={localise('/tags/', locale)}>{strings.allSubjectsArrow} &rarr;</a>
            </li>
          </ul>
        </nav>
      </aside>

      <div class="index">
        {posts.length === 0 && (
          <p class="index__empty">
            {strings.emptyIndex}{' '}
            <a href="/writing/" hreflang="en">{strings.readInEnglish}</a>
          </p>
        )}
        {
          years.map(({ year, posts: inYear }) => (
            <section class="index__year">
              <h2 class="index__year-label label tnum" id={`y${year}`}>
                {yearIn(year, locale)}
              </h2>
              <div class="index__list">
                {inYear.map((post) => (
                  <PostEntry post={post} variant="index" />
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </div>
</Base>

<style>
  .index__empty {
    padding-block: var(--s-6);
    color: var(--fg-muted);
  }

  .page {
    padding-block: var(--s-8) var(--s-6);
  }

  .page__head {
    max-width: 56ch;
    margin-bottom: var(--s-8);
  }

  .page__title {
    font-size: var(--t-2xl);
    margin-block: var(--s-3) var(--s-4);
  }

  .page__lede {
    max-width: 52ch;
  }

  .page__grid {
    display: grid;
    gap: var(--s-7);
    grid-template-columns: minmax(0, 1fr);
  }

  /* --- the rail ------------------------------------------------------- */

  .rail {
    display: grid;
    gap: var(--s-6);
    align-content: start;
  }

  .rail__head {
    padding-bottom: var(--s-2);
    border-bottom: var(--rule-w) solid var(--rule);
    margin-bottom: var(--s-3);
  }

  .rail__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-2);
  }

  .rail__list--inline {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-4);
  }

  .rail__list a {
    display: inline-flex;
    align-items: baseline;
    gap: var(--s-2);
    font-size: var(--t-sm);
    text-decoration: none;
    color: var(--fg-muted);
    transition: color var(--dur-fast) var(--ease);
  }

  .rail__list a:hover {
    color: var(--accent);
  }

  .rail__n {
    font-family: var(--face-mono);
    font-size: var(--t-2xs);
    color: var(--fg-faint);
  }

  /* --- the year index ------------------------------------------------- */

  .index__year + .index__year {
    margin-top: var(--s-7);
  }

  .index__year-label {
    font-size: var(--t-sm);
    letter-spacing: var(--tr-wide);
    color: var(--fg-faint);
    padding-bottom: var(--s-2);
    border-bottom: var(--rule-w) solid var(--rule-strong);
    scroll-margin-top: var(--s-6);
  }

  /* Above 60rem the rail moves to the right, so the index keeps the reader's
     natural left edge and the page reads as content-first. At 4K the rail
     widens rather than the list, keeping the measure honest. */
  @media (min-width: 60rem) {
    .page__grid {
      grid-template-columns: minmax(0, 1fr) minmax(13rem, 17rem);
      column-gap: clamp(var(--s-6), 5vw, var(--s-9));
      align-items: start;
    }

    .rail {
      order: 2;
      position: sticky;
      top: var(--s-6);
    }

    .index {
      order: 1;
      max-width: 62ch;
    }

    .index__year {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (min-width: 112.5rem) {
    .page__grid {
      grid-template-columns: minmax(0, 1fr) minmax(17rem, 22rem);
    }

    .index {
      max-width: 68ch;
    }
  }
</style>
