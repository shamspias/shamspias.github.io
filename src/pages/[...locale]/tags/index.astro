---
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import { allPosts, tagCounts } from '../../../lib/posts';
import { collectionPage } from '../../../lib/seo';
import { localePaths, localise, num, t, type Locale } from '../../../i18n';
import { tagLabel } from '../../../i18n/tags';

export const getStaticPaths = (() => localePaths()) satisfies GetStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const strings = t(locale);

const posts = await allPosts(locale);
const tags = tagCounts(posts);
const max = tags[0]?.count ?? 1;
const url = localise('/tags/', locale);

const tagsSchema = collectionPage({
  url,
  name: `${strings.subjects} · Shamsuddin Ahmed`,
  description: strings.subjectsLede,
  locale,
  trail: [
    { name: strings.home, url: localise('/', locale) },
    { name: strings.subjects, url },
  ],
  items: tags.map((row) => ({
    name: `${tagLabel(row.tag, locale)} (${row.count})`,
    url: localise(`/tags/${row.slug}/`, locale),
  })),
  about: tags.slice(0, 30).map((row) => row.tag),
});
---

<Base
  title={strings.subjects}
  description={strings.subjectsLede}
  keywords={tags.slice(0, 25).map((row) => row.tag)}
  schema={tagsSchema}
  locale={locale}
>
  <div class="wrap page">
    <header class="page__head">
      <p class="label">
        {num(locale, tags.length)} {strings.subjects} &nbsp;·&nbsp; {strings.nPosts(posts.length)}
      </p>
      <h1 class="display page__title">{strings.subjects}</h1>
      <p class="lede page__lede">{strings.subjectsLede}</p>
    </header>

    <ul class="tags">
      {
        tags.map((row) => (
          <li class="tag">
            <a class="tag__link" href={localise(`/tags/${row.slug}/`, locale)}>
              <span class="tag__name">{tagLabel(row.tag, locale)}</span>
              <span
                class="tag__bar"
                aria-hidden="true"
                style={`--w:${Math.max(6, (row.count / max) * 100)}%`}
              />
              <span class="tag__n label tnum">{num(locale, row.count)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .page {
    padding-block: var(--s-8) var(--s-6);
  }

  .page__head {
    max-width: 56ch;
    margin-bottom: var(--s-7);
  }

  .page__title {
    font-size: var(--t-2xl);
    margin-block: var(--s-3) var(--s-4);
  }

  .page__lede {
    max-width: 52ch;
  }

  .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 52ch;
    border-top: var(--rule-w) solid var(--rule-strong);
  }

  .tag {
    border-bottom: var(--rule-w) solid var(--rule);
  }

  .tag__link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s-2) var(--s-4);
    padding-block: var(--s-3);
    text-decoration: none;
  }

  .tag__name {
    font-size: var(--t-sm);
    color: var(--fg);
    transition: color var(--dur-fast) var(--ease);
  }

  .tag__link:hover .tag__name {
    color: var(--accent);
  }

  /* The share bar is a rule, not a chart. It is the same hairline as every
     other divider on the site, just cut to length. */
  .tag__bar {
    grid-column: 1 / -1;
    grid-row: 2;
    height: 0;
    border-top: 2px solid var(--rule-strong);
    width: var(--w);
    transition: border-color var(--dur-fast) var(--ease);
  }

  .tag__link:hover .tag__bar {
    border-color: var(--accent);
  }

  .tag__n {
    grid-column: 2;
    grid-row: 1;
    color: var(--fg-faint);
  }
</style>
