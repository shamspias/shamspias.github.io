---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PostEntry from '../../components/PostEntry.astro';
import { allPosts, plainTitle, slugifyTag, tagCounts, urlOf } from '../../lib/posts';
import { clamp, collectionPage } from '../../lib/seo';

export const getStaticPaths = (async () => {
  const posts = await allPosts();
  return tagCounts(posts).map((t) => ({
    params: { tag: t.slug },
    props: {
      tag: t.tag,
      posts: posts.filter((p) => p.data.tags.some((x) => slugifyTag(x) === t.slug)),
    },
  }));
}) satisfies GetStaticPaths;

const { tag, posts } = Astro.props;

const url = `/tags/${slugifyTag(tag)}/`;
const count = `${posts.length} ${posts.length === 1 ? 'post' : 'posts'}`;

// A tag page holding one post is a copy of that post's title and blurb at a
// second address. It stays on the site and stays crawlable, so a reader and a
// crawler can both follow it, but it is kept out of the index: ninety-five
// near-duplicate pages competing with the posts they point at helps nobody.
const thin = posts.length < 2;

// A snippet has to say something. "4 posts on docking" is a label, not a
// description, so the titles of the pieces themselves carry it: they are the
// words a reader searching this subject would actually have typed.
const sample = posts
  .slice(0, 3)
  .map((p) => plainTitle(p.data.title).replace(/[.:].*$/, '').trim())
  .join('; ');
const description = clamp(
  `${count} on ${tag} by Shamsuddin Ahmed` +
    (sample ? `, including ${sample}.` : '.') +
    ' Worked examples, measured results, and the code behind them.',
);

// The neighbouring subjects, which is how a thin index page earns its keep: it
// tells a crawler what else this one sits beside.
const neighbours = [
  ...new Set(posts.flatMap((p) => p.data.tags).filter((t) => t !== tag)),
].slice(0, 12);

const schema = collectionPage({
  url,
  name: `${tag} · writing by Shamsuddin Ahmed`,
  description,
  trail: [
    { name: 'Home', url: '/' },
    { name: 'Subjects', url: '/tags/' },
    { name: tag, url },
  ],
  items: posts.map((p) => ({ name: plainTitle(p.data.title), url: urlOf(p) })),
  about: [tag, ...neighbours],
});
---

<Base
  title={tag}
  description={description}
  keywords={[tag, ...neighbours]}
  schema={schema}
  noindex={thin}
>
  <div class="wrap page">
    <header class="page__head">
      <p class="label">
        Subject &nbsp;·&nbsp; {posts.length} {posts.length === 1 ? 'post' : 'posts'}
      </p>
      <h1 class="display page__title">{tag}</h1>
    </header>

    <div class="list">
      {posts.map((post) => <PostEntry post={post} variant="card" />)}
    </div>

    <p class="page__back">
      <a href="/tags/">All subjects</a>
      <span class="page__sep" aria-hidden="true"></span>
      <a href="/writing/">All writing</a>
    </p>
  </div>
</Base>

<style>
  .page {
    padding-block: var(--s-8) var(--s-6);
  }

  .page__head {
    margin-bottom: var(--s-6);
  }

  .page__title {
    font-size: var(--t-2xl);
    margin-top: var(--s-3);
  }

  .list {
    border-top: var(--rule-w) solid var(--rule-strong);
    max-width: 76ch;
  }

  .page__back {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-7);
    font-size: var(--t-sm);
  }

  .page__back a {
    color: var(--fg-strong);
    text-decoration-color: var(--accent);
  }

  .page__back a:hover {
    color: var(--accent);
  }

  .page__sep {
    width: var(--s-5);
    border-top: var(--rule-w) solid var(--rule-strong);
  }
</style>
