---
/**
 * Every English post. The view is shared with the localised route so there is
 * one template and two ways in, rather than two templates drifting apart.
 *
 * English is unprefixed, which is why this route exists separately at all: a
 * single rest parameter cannot carry both the language and the post path.
 */
import type { GetStaticPaths } from 'astro';
import PostPage from '../../components/PostPage.astro';
import { allPosts, routeParam, seriesOf, translationsOf, urlOf } from '../../lib/posts';
import type { Locale } from '../../i18n';

export const getStaticPaths = (async () => {
  const posts = await allPosts('en');
  return Promise.all(
    posts.map(async (post, i) => {
      const found = await translationsOf(post.data.permalink);
      const hrefs = Object.fromEntries(
        [...found].map(([locale, p]) => [locale, urlOf(p)]),
      ) as Partial<Record<Locale, string>>;
      return {
        params: { path: routeParam(post) },
        props: {
          post,
          newer: posts[i - 1] ?? null,
          older: posts[i + 1] ?? null,
          siblings: post.data.series ? seriesOf(posts, post.data.series) : [],
          hrefs,
        },
      };
    }),
  );
}) satisfies GetStaticPaths;
---

<PostPage {...Astro.props} />
