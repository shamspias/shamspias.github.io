---
import { NAV, SITE } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

const here = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? here === '/' : here.startsWith(href));
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="wordmark" href="/" aria-label={`${SITE.name}, home`}>
      <span class="wordmark__name">Shamsuddin Ahmed</span>
      <span class="wordmark__role label">{SITE.role}</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul class="site-nav__list">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    border-bottom: var(--rule-w) solid var(--rule);
    background: var(--bg);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    min-height: 4.25rem;
    padding-block: var(--s-3);
  }

  .wordmark {
    text-decoration: none;
    display: grid;
    gap: 0.1rem;
    margin-right: auto;
  }

  .wordmark__name {
    font-family: var(--face-display);
    font-size: var(--t-md);
    font-weight: 500;
    letter-spacing: var(--tr-snug);
    color: var(--fg-strong);
    line-height: 1.1;
  }

  .wordmark__role {
    color: var(--fg-faint);
  }

  .wordmark:hover .wordmark__name {
    color: var(--accent);
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: clamp(var(--s-4), 2.5vw, var(--s-6));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav a {
    display: inline-block;
    font-size: var(--t-sm);
    text-decoration: none;
    color: var(--fg-muted);
    padding-block: var(--s-1);
    border-bottom: 1px solid transparent;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .site-nav a:hover {
    color: var(--fg-strong);
    border-bottom-color: var(--rule-strong);
  }

  /* The current section is marked by a rule in the accent, the one place other
     than links where the accent is allowed to appear. */
  .site-nav a[aria-current='page'] {
    color: var(--fg-strong);
    border-bottom-color: var(--accent);
  }

  /* On a narrow phone the role drops away and the nav sits under the wordmark,
     which keeps three items on one line without shrinking the type. */
  @media (max-width: 30rem) {
    .site-header__inner {
      flex-wrap: wrap;
      row-gap: var(--s-2);
      padding-block: var(--s-3);
    }

    .wordmark__role {
      display: none;
    }

    .site-nav {
      order: 3;
      flex: 1 1 100%;
    }

    .site-nav__list {
      gap: var(--s-5);
      padding-bottom: var(--s-1);
    }
  }
</style>
