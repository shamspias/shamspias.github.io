---
import { SITE } from '../consts';
import ThemeToggle from './ThemeToggle.astro';
import LangSwitch from './LangSwitch.astro';
import { DEFAULT_LOCALE, delocalise, localise, t, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
  hrefs?: Partial<Record<Locale, string>>;
}

const { locale = DEFAULT_LOCALE, hrefs = {} } = Astro.props;
const strings = t(locale);

// The nav is built per language. Labels are translated either way, because a
// label says what the page is; the address is prefixed only for the pages that
// exist in this language. Projects is a portfolio of proper nouns, stacks and
// repository names, so it is published in English only, and linking a Bangla
// nav item at `/bn/projects/` would be linking at nothing.
const NAV = [
  { label: strings.writing, href: localise('/writing/', locale), translated: true },
  { label: strings.projects, href: '/projects/', translated: false },
  { label: strings.surprised, href: '/surprised/', translated: false },
] as const;

const here = delocalise(Astro.url.pathname).path;
const isCurrent = (href: string) => {
  const target = delocalise(href).path;
  return target === '/' ? here === '/' : here.startsWith(target);
};
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="wordmark" href={localise('/', locale)} aria-label={`${SITE.name}, ${strings.home}`}>
      <span class="wordmark__name">{SITE.name}</span>
      <span class="wordmark__role label">{strings.role}</span>
    </a>

    <nav class="site-nav" aria-label={strings.primaryNav}>
      <ul class="site-nav__list">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                hreflang={item.translated ? undefined : 'en'}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <LangSwitch current={locale} hrefs={hrefs} />
    <ThemeToggle locale={locale} />
  </div>
</header>

<style>
  /* The one red, stated once at the head of every page. A press sheet carries
     its second ink at the trim edge; this is that, and it is the only place the
     accent appears as a field rather than as a mark on something clickable. */
  .site-header {
    border-top: 3px solid var(--accent);
    border-bottom: var(--rule-w) solid var(--rule);
    background: var(--bg);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    min-height: 4.25rem;
    padding-block: var(--s-3);
  }

  .wordmark {
    text-decoration: none;
    display: grid;
    gap: 0.1rem;
    margin-inline-end: auto;
  }

  .wordmark__name {
    font-family: var(--face-display);
    font-size: var(--t-md);
    font-weight: 500;
    letter-spacing: var(--tr-snug);
    color: var(--fg-strong);
    line-height: 1.1;
  }

  .wordmark__role {
    color: var(--fg-faint);
  }

  /* The role reads as a tracked latin label in English. In Bangla that
     treatment is wrong: the script has no case to raise and loses legibility
     when letters are pushed apart. */
  :global(html[lang='bn']) .wordmark__role {
    font-family: var(--face-text);
    text-transform: none;
    letter-spacing: 0;
  }

  .wordmark:hover .wordmark__name {
    color: var(--accent);
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: clamp(var(--s-3), 2vw, var(--s-5));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav a {
    display: inline-block;
    font-size: var(--t-sm);
    text-decoration: none;
    color: var(--fg-muted);
    padding-block: var(--s-1);
    border-bottom: 1px solid transparent;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .site-nav a:hover {
    color: var(--fg-strong);
    border-bottom-color: var(--rule-strong);
  }

  /* The current section is marked by a rule in the accent, the one place other
     than links where the accent is allowed to appear. */
  .site-nav a[aria-current='page'] {
    color: var(--fg-strong);
    border-bottom-color: var(--accent);
  }

  /* On a narrow phone the role drops away and the nav sits under the wordmark,
     which keeps three items on one line without shrinking the type. */
  @media (max-width: 30rem) {
    .site-header__inner {
      flex-wrap: wrap;
      row-gap: var(--s-2);
      padding-block: var(--s-3);
    }

    .wordmark__role {
      display: none;
    }

    .site-nav {
      order: 3;
      flex: 1 1 100%;
    }

    .site-nav__list {
      gap: var(--s-5);
      padding-bottom: var(--s-1);
    }
  }
</style>
