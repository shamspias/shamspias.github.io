---
import { Font } from 'astro:assets';
import { SITE } from '../consts';
import { ogCard } from '../lib/seo';
import { DEFAULT_LOCALE, LOCALES, LOCALE_META, t, type Locale } from '../i18n';
import { LANGUAGE_TO_LOCALE, LOCALE_STORAGE_KEY, ZONE_TO_LOCALE } from '../i18n/config';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Set on article pages so the OG type and dates are right. */
  article?: { published: Date; modified?: Date; tags?: string[]; section?: string };
  /** Only the pages that contain maths pay for the KaTeX stylesheet. */
  math?: boolean;
  noindex?: boolean;
  /** Subject terms for this page, in priority order. */
  keywords?: readonly string[];
  /** Suppress the brand suffix when the page title is already long. */
  bareTitle?: boolean;
  /** The 404 page: there is no preferred URL for a page that does not exist. */
  noCanonical?: boolean;
  locale?: Locale;
  available?: readonly Locale[];
  /** This page's address in each language it exists in. */
  hrefs?: Partial<Record<Locale, string>>;
}

const {
  title,
  description,
  article,
  math = false,
  noindex = false,
  keywords = [],
  bareTitle = false,
  noCanonical = false,
  locale = DEFAULT_LOCALE,
  available = LOCALES,
  hrefs = {},
} = Astro.props;

const meta = LOCALE_META[locale];
const strings = t(locale);
const origin = Astro.site ?? new URL(SITE.url);
const canonical = new URL(Astro.url.pathname, origin).href;

// A result is cut around sixty characters. The brand suffix earns its place on a
// short title and steals the end of a long one, so it is dropped when the page
// title already fills the line.
const suffix = ` · ${SITE.name}`;
const fullTitle =
  title === SITE.name
    ? `${SITE.name} · ${strings.role}`
    : bareTitle || title.length + suffix.length > 62
      ? title
      : title + suffix;

const card = ogCard(Astro.url.pathname, title, locale);

// Google reads this to decide how much of the page it may show. Left off, it
// defaults to a truncated snippet and a thumbnail-sized image.
const robots = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const keywordList = [...new Set([...keywords, ...(article?.tags ?? [])])];

// Every version points at every other one and at itself, which is what the
// specification requires: a set with a missing return reference is ignored.
// A page that exists in one language is not a set, so it gets nothing: an
// hreflang pointing only at itself says nothing, and pointing at an address
// that was never generated is worse than saying nothing.
const alternateLinks =
  available.length > 1
    ? [
        ...available.map((l) => ({
          hreflang: LOCALE_META[l].tag,
          href: new URL(hrefs[l] ?? Astro.url.pathname, origin).href,
        })),
        ...(available.includes(DEFAULT_LOCALE)
          ? [
              {
                hreflang: 'x-default',
                href: new URL(hrefs[DEFAULT_LOCALE] ?? '/', origin).href,
              },
            ]
          : []),
      ]
    : [];

// The two locales whose scripts the latin faces cannot set. Loaded only on the
// pages written in them, so an English reader never pays for either.
const needsBengali = locale === 'bn';
const needsArabic = locale === 'ar';
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title>{fullTitle}</title>
<meta name="description" content={description} />
{!noCanonical && <link rel="canonical" href={canonical} />}
<meta name="robots" content={robots} />
<meta name="googlebot" content={robots} />
{keywordList.length > 0 && <meta name="keywords" content={keywordList.join(', ')} />}

{alternateLinks.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

<meta name="author" content={SITE.name} />
<link rel="author" href={SITE.url} />
<meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#121214" media="(prefers-color-scheme: dark)" />

<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={card.url} />
<meta property="og:image:secure_url" content={card.url} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content={String(card.width)} />
<meta property="og:image:height" content={String(card.height)} />
<meta property="og:image:alt" content={card.alt} />
<meta property="og:locale" content={meta.og} />
{
  available
    .filter((l) => l !== locale)
    .map((l) => <meta property="og:locale:alternate" content={LOCALE_META[l].og} />)
}
{
  article && (
    <>
      <meta property="article:published_time" content={article.published.toISOString()} />
      <meta property="article:author" content={SITE.url} />
      {article.section && <meta property="article:section" content={article.section} />}
    </>
  )
}
{article?.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
{article?.tags?.map((t) => <meta property="article:tag" content={t} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={card.url} />
<meta name="twitter:image:alt" content={card.alt} />
<meta name="twitter:label1" content="Written by" />
<meta name="twitter:data1" content={SITE.name} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="alternate" type="application/rss+xml" title={`${SITE.name} · Writing`} href="/rss.xml" />
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

{/* No `preload`: it is per-family, so it would preload every weight and style
    of a family at once. Astro emits a metric-matched fallback for each face, so
    `font-display: swap` swaps without shifting the layout, and the browser
    fetches only the instances a given page actually uses. */}
<Font cssVariable="--font-display" />
<Font cssVariable="--font-text" />
<Font cssVariable="--font-mono" />
{needsBengali && <Font cssVariable="--font-bengali" />}
{needsArabic && <Font cssVariable="--font-arabic" />}

{math && <link rel="stylesheet" href="/katex/katex.min.css" />}

{/* Applies the stored theme before first paint so there is no flash. Inline and
    tiny by necessity: anything deferred is, by definition, too late. */}
<script is:inline>
  (() => {
    try {
      const t = localStorage.getItem('theme');
      if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
    } catch {}
  })();
</script>

{/* The language rule.
    A folder of static files has no server, so there is nothing to read a
    country off a request. The best signal a browser gives is its time zone,
    which is a place rather than a preference, and that is what this uses:
    Bangladesh gets Bangla, the Arabic-speaking countries get Arabic, everyone
    else gets English. A stored choice always wins, `?lang=` always wins over
    that, and a language this page does not exist in is never navigated to. */}
<script
  is:inline
  define:vars={{
    here: locale,
    hrefs,
    zones: ZONE_TO_LOCALE,
    languages: LANGUAGE_TO_LOCALE,
    key: LOCALE_STORAGE_KEY,
    fallback: DEFAULT_LOCALE,
  }}
>
  (() => {
    const store = (value) => {
      try {
        localStorage.setItem(key, value);
      } catch {}
    };
    const stored = (() => {
      try {
        return localStorage.getItem(key);
      } catch {
        return null;
      }
    })();

    // An explicit ?lang= is a decision, it is remembered, and it ends the
    // matter: falling through to the rules below would let a previously stored
    // choice overrule the one just made in the address bar.
    const forced = new URLSearchParams(location.search).get('lang');
    if (forced && hrefs[forced]) {
      store(forced);
      if (forced !== here) location.replace(hrefs[forced] + location.hash);
      return;
    }

    // Landing on a prefixed page is itself a decision: somebody followed a link
    // to `/ar/...` or typed it. Remember it and stay put. Without this, a deep
    // link to the Arabic site would be unusable from Bangladesh, because the
    // rule below would send every visitor straight back to Bangla.
    if (here !== fallback) {
      if (!stored) store(here);
      return;
    }

    let want = stored && hrefs[stored] ? stored : null;

    if (!want) {
      // Where the reader is, then what they read, then English.
      let zone = '';
      try {
        zone = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
      } catch {}
      const byZone = zones[zone];
      const byLanguage = (navigator.languages || [navigator.language || ''])
        .map((tag) => languages[String(tag).slice(0, 2).toLowerCase()])
        .find(Boolean);
      want = byZone || byLanguage || fallback;
    }

    if (want !== here && hrefs[want]) location.replace(hrefs[want] + location.hash);
  })();
</script>
