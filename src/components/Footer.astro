---
import { SITE, SOCIAL } from '../consts';
import { allPosts, groupBySeries } from '../lib/posts';
import { DEFAULT_LOCALE, localise, t, yearIn, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const strings = t(locale);

// Counted in the language of the page: a Bangla footer that says "39 posts"
// while listing Bangla ones would be counting the wrong shelf.
const posts = await allPosts(locale);
const seriesCount = groupBySeries(posts).length;

// The copyright year is dynamic: it is the year the site was last built.
const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <div class="site-footer__block">
      <p class="label site-footer__heading">{strings.elsewhere}</p>
      <ul class="site-footer__links">
        {
          SOCIAL.map((s) => (
            <li>
              <a href={s.href} rel={s.href.startsWith('http') ? 'me noopener' : undefined}>
                {s.label}
                <span class="site-footer__handle">{s.handle}</span>
              </a>
            </li>
          ))
        }
        <li>
          <a href="/rss.xml">
            RSS<span class="site-footer__handle">/rss.xml</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="site-footer__block">
      <p class="label site-footer__heading">{strings.read}</p>
      <ul class="site-footer__links">
        <li>
          <a href={localise('/writing/', locale)}>
            {strings.allWriting}
            <span class="site-footer__handle">{strings.nPosts(posts.length)}</span>
          </a>
        </li>
        <li>
          <a href={localise('/series/', locale)}>
            {strings.series}
            <span class="site-footer__handle">{strings.nSeries(seriesCount)}</span>
          </a>
        </li>
        <li>
          <a href={localise('/tags/', locale)}>
            {strings.subjects}
            <span class="site-footer__handle">{strings.bySubject}</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="site-footer__block site-footer__colophon">
      <p class="label site-footer__heading">{strings.thisSite}</p>
      <p>{strings.colophon}</p>
      <p class="site-footer__legal">{strings.legal(yearIn(year, locale), SITE.name)}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--s-11);
    border-top: var(--rule-w) solid var(--rule);
    background: var(--bg);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--s-7);
    padding-block: var(--s-8) var(--s-9);
    grid-template-columns: 1fr;
  }

  .site-footer__heading {
    margin-bottom: var(--s-3);
    color: var(--fg-faint);
  }

  .site-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-2);
  }

  .site-footer__links a {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    text-decoration: none;
    font-size: var(--t-sm);
    color: var(--fg);
    width: fit-content;
    transition: color var(--dur-fast) var(--ease);
  }

  .site-footer__links a:hover {
    color: var(--accent);
  }

  /* The handle is the developer-friendly half: the actual address, in mono,
     so it can be read and typed rather than only clicked. */
  .site-footer__handle {
    font-family: var(--face-mono);
    font-size: var(--t-2xs);
    color: var(--fg-faint);
    letter-spacing: 0.01em;
  }

  .site-footer__colophon p {
    font-size: var(--t-sm);
    color: var(--fg-muted);
    max-width: 46ch;
    text-wrap: pretty;
  }

  .site-footer__legal {
    margin-top: var(--s-4);
    color: var(--fg-faint);
    font-size: var(--t-xs);
  }

  @media (min-width: 45rem) {
    .site-footer__inner {
      grid-template-columns: auto auto minmax(0, 1fr);
      gap: clamp(var(--s-6), 6vw, var(--s-10));
    }
  }
</style>
