---
import { SITE, SOCIAL } from '../consts';
import { allPosts, groupBySeries } from '../lib/posts';

const posts = await allPosts();
const seriesCount = groupBySeries(posts).length;

const year = new Date().getUTCFullYear();
const span = year > SITE.since ? `${SITE.since}–${year}` : `${year}`;
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <div class="site-footer__block">
      <p class="label site-footer__heading">Elsewhere</p>
      <ul class="site-footer__links">
        {
          SOCIAL.map((s) => (
            <li>
              <a href={s.href} rel={s.href.startsWith('http') ? 'me noopener' : undefined}>
                {s.label}
                <span class="site-footer__handle">{s.handle}</span>
              </a>
            </li>
          ))
        }
        <li>
          <a href="/rss.xml">
            RSS<span class="site-footer__handle">/rss.xml</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="site-footer__block">
      <p class="label site-footer__heading">Read</p>
      <ul class="site-footer__links">
        <li>
          <a href="/writing/">All writing<span class="site-footer__handle">{posts.length} posts</span></a>
        </li>
        <li>
          <a href="/series/">Series<span class="site-footer__handle">{seriesCount} runs</span></a>
        </li>
        <li><a href="/tags/">Tags<span class="site-footer__handle">by subject</span></a></li>
      </ul>
    </div>

    {/* A colophon. It states what the thing is made of, which is the oldest
        signal in print that somebody cared about the object. */}
    <div class="site-footer__block site-footer__colophon">
      <p class="label site-footer__heading">Colophon</p>
      <p>
        Set in <span class="colophon__face colophon__face--display">Newsreader</span>,{' '}
        <span class="colophon__face colophon__face--sans">Inter&nbsp;Tight</span> and{' '}
        <span class="colophon__face colophon__face--mono">Commit&nbsp;Mono</span>. Built with Astro,
        no client-side framework, and served as static files.
      </p>
      <p class="site-footer__legal">
        &copy; {span} {SITE.name}. Words and code are mine; the code is MIT.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--s-11);
    border-top: var(--rule-w) solid var(--rule);
    background: var(--bg);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--s-7);
    padding-block: var(--s-8) var(--s-9);
    grid-template-columns: 1fr;
  }

  .site-footer__heading {
    margin-bottom: var(--s-3);
    color: var(--fg-faint);
  }

  .site-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-2);
  }

  .site-footer__links a {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    text-decoration: none;
    font-size: var(--t-sm);
    color: var(--fg);
    width: fit-content;
    transition: color var(--dur-fast) var(--ease);
  }

  .site-footer__links a:hover {
    color: var(--accent);
  }

  /* The handle is the developer-friendly half: the actual address, in mono,
     so it can be read and typed rather than only clicked. */
  .site-footer__handle {
    font-family: var(--face-mono);
    font-size: var(--t-2xs);
    color: var(--fg-faint);
    letter-spacing: 0.01em;
  }

  .site-footer__colophon p {
    font-size: var(--t-sm);
    color: var(--fg-muted);
    max-width: 46ch;
    text-wrap: pretty;
  }

  .site-footer__legal {
    margin-top: var(--s-4);
    color: var(--fg-faint);
    font-size: var(--t-xs);
  }

  /* Each face is named in itself. A small joke, and also a live specimen. */
  .colophon__face--display {
    font-family: var(--face-display);
    font-style: italic;
    color: var(--fg);
  }

  .colophon__face--sans {
    font-family: var(--face-sans);
    color: var(--fg);
  }

  .colophon__face--mono {
    font-family: var(--face-mono);
    font-size: 0.92em;
    color: var(--fg);
  }

  @media (min-width: 45rem) {
    .site-footer__inner {
      grid-template-columns: auto auto minmax(0, 1fr);
      gap: clamp(var(--s-6), 6vw, var(--s-10));
    }
  }
</style>
